{"schemaVersion":1,"slug":"graph-valid-tree","title":"Graph Valid Tree","pattern":"Graphs","difficulty":"Medium","leetcode":261,"prompt":"Decide whether an undirected graph is a tree: fully connected, with no cycles.","examples":[{"input":"n = 5, edges = [[0,1],[0,2],[0,3],[1,4]]","output":"true"},{"input":"n = 5, edges = [[0,1],[1,2],[2,3],[1,3],[1,4]]","output":"false","why":"The edges 1-2, 2-3, 1-3 close a cycle."}],"constraints":["1 <= n <= 2000","No self-loops or duplicate edges"],"approaches":[{"id":"count-walk","label":"Count edges, then walk","complexity":{"time":"O(V + E)","space":"O(V)"},"viz":{"adj":"graph","seen":"marked:adj","stack":"stack"},"layout":{"adj":{"0":[0.0,-1.0],"1":[0.9511,-0.309],"2":[0.5878,0.809],"3":[-0.5878,0.809],"4":[-0.9511,-0.309]}},"source":["def count_edges_and_walk(adj):","    edge_count = 0","    for node in adj:","        edge_count += len(adj[node])","    edge_count = edge_count // 2","    if edge_count != len(adj) - 1:","        return False","    seen = {}","    stack = [next(iter(adj))]","    while stack:","        node = stack.pop()","        if node in seen:","            continue","        seen[node] = True","        for other in adj[node]:","            stack.append(other)","    return len(seen) == len(adj)"],"variants":[{"id":"typical","label":"Is a tree","note":null,"result":true,"steps":[{"line":0,"note":null,"ops":[["set",["adj"],{"0":[1,2,3],"1":[0,4],"2":[0],"3":[0],"4":[1]}]]},{"line":1,"note":"more means it must contain a cycle \u2014 so this check does half the work.","ops":[["set",["edge_count"],0]]},{"line":2,"note":null,"ops":[["set",["node"],0]]},{"line":3,"note":null,"ops":[["set",["edge_count"],3]]},{"line":2,"note":null,"ops":[["set",["node"],1]]},{"line":3,"note":null,"ops":[["set",["edge_count"],5]]},{"line":2,"note":null,"ops":[["set",["node"],2]]},{"line":3,"note":null,"ops":[["set",["edge_count"],6]]},{"line":2,"note":null,"ops":[["set",["node"],3]]},{"line":3,"note":null,"ops":[["set",["edge_count"],7]]},{"line":2,"note":null,"ops":[["set",["node"],4]]},{"line":3,"note":null,"ops":[["set",["edge_count"],8]]},{"line":2,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["edge_count"],4]]},{"line":5,"note":null,"ops":[]},{"line":7,"note":"reach everything from one node and a cycle becomes impossible.","ops":[["set",["seen"],{}]]},{"line":8,"note":null,"ops":[["set",["stack"],[0]]]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],0],["set",["stack"],[]]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["seen","0"],true]]},{"line":14,"note":null,"ops":[["set",["other"],1]]},{"line":15,"note":null,"ops":[["set",["stack"],[1]]]},{"line":14,"note":null,"ops":[["set",["other"],2]]},{"line":15,"note":null,"ops":[["set",["stack"],[1,2]]]},{"line":14,"note":null,"ops":[["set",["other"],3]]},{"line":15,"note":null,"ops":[["set",["stack"],[1,2,3]]]},{"line":14,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],3],["set",["stack"],[1,2]]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["seen","3"],true]]},{"line":14,"note":null,"ops":[["set",["other"],0]]},{"line":15,"note":null,"ops":[["set",["stack"],[1,2,0]]]},{"line":14,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],0],["set",["stack"],[1,2]]]},{"line":11,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],2],["set",["stack"],[1]]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["seen","2"],true]]},{"line":14,"note":null,"ops":[]},{"line":15,"note":null,"ops":[["set",["stack"],[1,0]]]},{"line":14,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],0],["set",["stack"],[1]]]},{"line":11,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],1],["set",["stack"],[]]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["seen","1"],true]]},{"line":14,"note":null,"ops":[]},{"line":15,"note":null,"ops":[["set",["stack"],[0]]]},{"line":14,"note":null,"ops":[["set",["other"],4]]},{"line":15,"note":null,"ops":[["set",["stack"],[0,4]]]},{"line":14,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],4],["set",["stack"],[0]]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["seen","4"],true]]},{"line":14,"note":null,"ops":[["set",["other"],1]]},{"line":15,"note":null,"ops":[["set",["stack"],[0,1]]]},{"line":14,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],1],["set",["stack"],[0]]]},{"line":11,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["node"],0],["set",["stack"],[]]]},{"line":11,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":9,"note":null,"ops":[]},{"line":16,"note":null,"ops":[]}]},{"id":"edge","label":"Has a cycle","note":null,"result":false,"steps":[{"line":0,"note":null,"ops":[["set",["adj"],{"0":[1],"1":[0,2,3],"2":[1,3],"3":[1,2]}]]},{"line":1,"note":"more means it must contain a cycle \u2014 so this check does half the work.","ops":[["set",["edge_count"],0]]},{"line":2,"note":null,"ops":[["set",["node"],0]]},{"line":3,"note":null,"ops":[["set",["edge_count"],1]]},{"line":2,"note":null,"ops":[["set",["node"],1]]},{"line":3,"note":null,"ops":[["set",["edge_count"],4]]},{"line":2,"note":null,"ops":[["set",["node"],2]]},{"line":3,"note":null,"ops":[["set",["edge_count"],6]]},{"line":2,"note":null,"ops":[["set",["node"],3]]},{"line":3,"note":null,"ops":[["set",["edge_count"],8]]},{"line":2,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["edge_count"],4]]},{"line":5,"note":null,"ops":[]},{"line":6,"note":null,"ops":[]}]},{"id":"worst-