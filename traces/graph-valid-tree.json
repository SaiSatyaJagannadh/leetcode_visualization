{"schemaVersion":1,"slug":"graph-valid-tree","title":"Graph Valid Tree","pattern":"Graphs","difficulty":"Medium","leetcode":261,"prompt":"Decide whether an undirected graph is a tree: fully connected, with no cycles.","examples":[{"input":"n = 5, edges = [[0,1],[0,2],[0,3],[1,4]]","output":"true"},{"input":"n = 5, edges = [[0,1],[1,2],[2,3],[1,3],[1,4]]","output":"false","why":"The edges 1-2, 2-3, 1-3 close a cycle."}],"constraints":["1 <= n <= 2000","No self-loops or duplicate edges"],"approaches":[{"id":"count-walk","label":"Count edges, then walk","complexity":{"time":"O(V + E)","space":"O(V)"},"viz":{"adj":"graph","seen":"marked:adj","stack":"stack"},"layout":{"adj":{"0":[0.0,-1.0],"1":[0.9511,-0.309],"2":[0.5878,0.809],"3":[-0.5878,0.809],"4":[-0.9511,-0.309]}},"source":["def count_edges_and_walk(adj):","    edge_count = 0","    for node in adj:","        edge_count += len(adj[node])","    edge_count = edge_count // 2","    if edge_count != len(adj) - 1:","        return False","    seen = {}","    stack = [next(iter(adj))]","    while stack:","        node = stack.pop()","        if node in seen:","            continue","        seen[node] = True","        for other in adj[node]:","            stack.append(other)","    return len(seen) == len(adj)"],"variants":[{"id":"typical","label":"Is a tree","note":null,"result":true,"steps":[{"line":0,"ops":[["set",["adj"],{"0":[1,2,3],"1":[0,4],"2":[0],"3":[0],"4":[1]}]],"note":null},{"line":1,"ops":[["set",["edge_count"],0]],"note":"more means it must contain a cycle \u2014 so this check does half the work."},{"line":2,"ops":[["set",["node"],0]],"note":null},{"line":3,"ops":[["set",["edge_count"],3]],"note":null},{"line":2,"ops":[["set",["node"],1]],"note":null},{"line":3,"ops":[["set",["edge_count"],5]],"note":null},{"line":2,"ops":[["set",["node"],2]],"note":null},{"line":3,"ops":[["set",["edge_count"],6]],"note":null},{"line":2,"ops":[["set",["node"],3]],"note":null},{"line":3,"ops":[["set",["edge_count"],7]],"note":null},{"line":2,"ops":[["set",["node"],4]],"note":null},{"line":3,"ops":[["set",["edge_count"],8]],"note":null},{"line":2,"ops":[],"note":null},{"line":4,"ops":[["set",["edge_count"],4]],"note":null},{"line":5,"ops":[],"note":null},{"line":7,"ops":[["set",["seen"],{}]],"note":"reach everything from one node and a cycle becomes impossible."},{"line":8,"ops":[["set",["stack"],[0]]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],0],["set",["stack"],[]]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[["set",["seen","0"],true]],"note":null},{"line":14,"ops":[["set",["other"],1]],"note":null},{"line":15,"ops":[["set",["stack"],[1]]],"note":null},{"line":14,"ops":[["set",["other"],2]],"note":null},{"line":15,"ops":[["set",["stack"],[1,2]]],"note":null},{"line":14,"ops":[["set",["other"],3]],"note":null},{"line":15,"ops":[["set",["stack"],[1,2,3]]],"note":null},{"line":14,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],3],["set",["stack"],[1,2]]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[["set",["seen","3"],true]],"note":null},{"line":14,"ops":[["set",["other"],0]],"note":null},{"line":15,"ops":[["set",["stack"],[1,2,0]]],"note":null},{"line":14,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],0],["set",["stack"],[1,2]]],"note":null},{"line":11,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],2],["set",["stack"],[1]]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[["set",["seen","2"],true]],"note":null},{"line":14,"ops":[],"note":null},{"line":15,"ops":[["set",["stack"],[1,0]]],"note":null},{"line":14,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],0],["set",["stack"],[1]]],"note":null},{"line":11,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],1],["set",["stack"],[]]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[["set",["seen","1"],true]],"note":null},{"line":14,"ops":[],"note":null},{"line":15,"ops":[["set",["stack"],[0]]],"note":null},{"line":14,"ops":[["set",["other"],4]],"note":null},{"line":15,"ops":[["set",["stack"],[0,4]]],"note":null},{"line":14,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],4],["set",["stack"],[0]]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[["set",["seen","4"],true]],"note":null},{"line":14,"ops":[["set",["other"],1]],"note":null},{"line":15,"ops":[["set",["stack"],[0,1]]],"note":null},{"line":14,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],1],["set",["stack"],[0]]],"note":null},{"line":11,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["node"],0],["set",["stack"],[]]],"note":null},{"line":11,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":16,"ops":[],"note":null}]},{"id":"edge","label":"Has a cycle","note":null,"result":false,"steps":[{"line":0,"ops":[["set",["adj"],{"0":[1],"1":[0,2,3],"2":[1,3],"3":[1,2]}]],"note":null},{"line":1,"ops":[["set",["edge_count"],0]],"note":"more means it must contain a cycle \u2014 so this check does half the work."},{"line":2,"ops":[["set",["node"],0]],"note":null},{"line":3,"ops":[["set",["edge_count"],1]],"note":null},{"line":2,"ops":[["set",["node"],1]],"note":null},{"line":3,"ops":[["set",["edge_count"],4]],"note":null},{"line":2,"ops":[["set",["node"],2]],"note":null},{"line":3,"ops":[["set",["edge_count"],6]],"note":null},{"line":2,"ops":[["set",["node"],3]],"note":null},{"line":3,"ops":[["set",["edge_count"],8]],"note":null},{"line":2,"ops":[],"note":null},{"line":4,"ops":[["set",["edge_count"],4]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[],"note":null}]},{"id":"worst-