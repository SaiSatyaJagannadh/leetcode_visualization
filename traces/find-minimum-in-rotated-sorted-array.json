{"schemaVersion":1,"slug":"find-minimum-in-rotated-sorted-array","title":"Find Minimum in Rotated Sorted Array","pattern":"Binary Search","difficulty":"Medium","leetcode":153,"prompt":"A sorted array of distinct values has been rotated some number of times. Find its smallest element in logarithmic time.","examples":[{"input":"nums = [3,4,5,1,2]","output":"1"},{"input":"nums = [11,13,15,17]","output":"11","why":"Rotated zero times, so it is still sorted."}],"constraints":["1 <= len(nums) <= 5000","All values distinct"],"approaches":[{"id":"scan","label":"Linear scan","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","i":"pointer:nums"},"layout":{},"source":["def scan(nums):","    best = nums[0]","    for i in range(len(nums)):","        if nums[i] < best:","            best = nums[i]","    return best"],"variants":[{"id":"typical","label":"Rotated","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["nums"],[4,5,6,7,0,1,2]]],"note":null},{"line":1,"ops":[["set",["best"],4]],"note":"Reading every element works, but ignores everything the sorting tells us."},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],4]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["best"],0]],"note":"A new low; the rotation point is at or before here."},{"line":2,"ops":[["set",["i"],5]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],6]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]},{"id":"edge","label":"Not rotated","note":null,"result":11,"steps":[{"line":0,"ops":[["set",["nums"],[11,13,15,17]]],"note":null},{"line":1,"ops":[["set",["best"],11]],"note":"Reading every element works, but ignores everything the sorting tells us."},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]},{"id":"worst-case","label":"Rotated by one","note":null,"result":1,"steps":[{"line":0,"ops":[["set",["nums"],[2,3,4,5,1]]],"note":null},{"line":1,"ops":[["set",["best"],2]],"note":"Reading every element works, but ignores everything the sorting tells us."},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["i"],4]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["best"],1]],"note":"A new low; the rotation point is at or before here."},{"line":2,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]}]},{"id":"binary","label":"Binary search","complexity":{"time":"O(log n)","space":"O(1)"},"viz":{"nums":"array","lo":"pointer:nums","hi":"pointer:nums","mid":"pointer:nums"},"layout":{},"source":["def binary(nums):","    lo, hi = 0, len(nums) - 1","    while lo < hi:","        mid = (lo + hi) // 2","        if nums[mid] > nums[hi]:","            lo = mid + 1","        else:","            hi = mid","    return nums[lo]"],"variants":[{"id":"typical","label":"Rotated","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["nums"],[4,5,6,7,0,1,2]]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],6]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],3]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":5,"ops":[["set",["lo"],4]],"note":"mid is in the high run before the break, so the break is past mid."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],5]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":7,"ops":[["set",["hi"],5]],"note":"mid is at or after the break, so the answer is mid or to its left."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],4]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":7,"ops":[["set",["hi"],4]],"note":"mid is at or after the break, so the answer is mid or to its left."},{"line":2,"ops":[],"note":null},{"line":8,"ops":[],"note":"lo met hi exactly at the rotation point."}]},{"id":"edge","label":"Not rotated","note":null,"result":11,"steps":[{"line":0,"ops":[["set",["nums"],[11,13,15,17]]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],3]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],1]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":7,"ops":[["set",["hi"],1]],"note":"mid is at or after the break, so the answer is mid or to its left."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],0]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":7,"ops":[["set",["hi"],0]],"note":"mid is at or after the break, so the answer is mid or to its left."},{"line":2,"ops":[],"note":null},{"line":8,"ops":[],"note":"lo met hi exactly at the rotation point."}]},{"id":"worst-case","label":"Rotated by one","note":null,"result":1,"steps":[{"line":0,"ops":[["set",["nums"],[2,3,4,5,1]]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],4]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],2]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":5,"ops":[["set",["lo"],3]],"note":"mid is in the high run before the break, so the break is past mid."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],3]],"note":null},{"line":4,"ops":[],"note":"and the minimum always sits at the break."},{"line":5,"ops":[["set",["lo"],4]],"note":"mid is in the high run before the break, so the break is past mid."},{"line":2,"ops":[],"note":null},{"line":8,"ops":[],"note":"lo met hi exactly at the rotation point."}]}]}]}