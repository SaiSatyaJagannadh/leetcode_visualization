{"schemaVersion":1,"slug":"find-minimum-in-rotated-sorted-array","title":"Find Minimum in Rotated Sorted Array","pattern":"Binary Search","difficulty":"Medium","leetcode":153,"prompt":"A sorted array of distinct values has been rotated some number of times. Find its smallest element in logarithmic time.","examples":[{"input":"nums = [3,4,5,1,2]","output":"1"},{"input":"nums = [11,13,15,17]","output":"11","why":"Rotated zero times, so it is still sorted."}],"constraints":["1 <= len(nums) <= 5000","All values distinct"],"approaches":[{"id":"scan","label":"Linear scan","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","i":"pointer:nums"},"layout":{},"source":["def scan(nums):","    best = nums[0]","    for i in range(len(nums)):","        if nums[i] < best:","            best = nums[i]","    return best"],"variants":[{"id":"typical","label":"Rotated","note":null,"result":0,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[4,5,6,7,0,1,2]]]},{"line":1,"note":null,"ops":[["set",["best"],4]]},{"line":2,"note":null,"ops":[["set",["i"],0]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],1]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],2]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],3]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],4]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["best"],0]]},{"line":2,"note":null,"ops":[["set",["i"],5]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],6]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[]},{"line":5,"note":null,"ops":[]}]},{"id":"edge","label":"Not rotated","note":null,"result":11,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[11,13,15,17]]]},{"line":1,"note":null,"ops":[["set",["best"],11]]},{"line":2,"note":null,"ops":[["set",["i"],0]]},{"line":3,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["i"],1]]},{"