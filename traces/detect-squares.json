{"schemaVersion":1,"slug":"detect-squares","title":"Detect Squares","pattern":"Math & Geometry","difficulty":"Medium","leetcode":2013,"prompt":"Points are added over time. Given a query point, count the axis-aligned squares that can be formed using it and three added points.","examples":[{"input":"add (0,0),(2,2),(0,2), then count (2,0)","output":"1"},{"input":"count (4,4)","output":"0"}],"constraints":["At most 5000 calls","Points may repeat"],"approaches":[{"id":"diagonal","label":"Anchor on the opposite corner","complexity":{"time":"O(n) per query","space":"O(n)"},"viz":{"counts":"map","points":"array"},"layout":{},"source":["def count_squares(points, query):","    counts = {}","    for p in points:","        key = str(p[0]) + \",\" + str(p[1])","        counts[key] = counts.get(key, 0) + 1","","    qx, qy = query[0], query[1]","    total = 0","    for key in counts:","        parts = key.split(\",\")","        px, py = int(parts[0]), int(parts[1])","        if abs(px - qx) != abs(py - qy) or px == qx:","            continue","        c1 = counts.get(str(px) + \",\" + str(qy), 0)","        c2 = counts.get(str(qx) + \",\" + str(py), 0)","        total += counts[key] * c1 * c2","    return total"],"variants":[{"id":"typical","label":"One square","note":null,"result":1,"steps":[{"line":0,"ops":[["set",["points"],[[0,0],[2,2],[0,2]]],["set",["query"],[2,0]]],"note":null},{"line":1,"ops":[["set",["counts"],{}]],"note":null},{"line":2,"ops":[["set",["p"],[0,0]]],"note":null},{"line":3,"ops":[["set",["key"],"0,0"]],"note":null},{"line":4,"ops":[["set",["counts","0,0"],1]],"note":null},{"line":2,"ops":[["set",["p",0],2],["set",["p",1],2]],"note":null},{"line":3,"ops":[["set",["key"],"2,2"]],"note":null},{"line":4,"ops":[["set",["counts","2,2"],1]],"note":null},{"line":2,"ops":[["set",["p",0],0]],"note":null},{"line":3,"ops":[["set",["key"],"0,2"]],"note":null},{"line":4,"ops":[["set",["counts","0,2"],1]],"note":null},{"line":2,"ops":[],"note":null},{"line":6,"ops":[["set",["qx"],2],["set",["qy"],0]],"note":null},{"line":7,"ops":[["set",["total"],0]],"note":null},{"line":8,"ops":[["set",["key"],"0,0"]],"note":null},{"line":9,"ops":[["set",["parts"],["0","0"]]],"note":null},{"line":10,"ops":[["set",["px"],0],["set",["py"],0]],"note":null},{"line":11,"ops":[],"note":"axis-aligned square that means equal horizontal and vertical distance."},{"line":12,"ops":[],"note":null},{"line":8,"ops":[["set",["key"],"2,2"]],"note":null},{"line":9,"ops":[["set",["parts",0],"2"],["set",["parts",1],"2"]],"note":null},{"line":10,"ops":[["set",["px"],2],["set",["py"],2]],"note":null},{"line":11,"ops":[],"note":"axis-aligned square that means equal horizontal and vertical distance."},{"line":12,"ops":[],"note":null},{"line":8,"ops":[["set",["key"],"0,2"]],"note":null},{"line":9,"ops":[["set",["parts",0],"0"]],"note":null},{"line":10,"ops":[["set",["px"],0]],"note":null},{"line":11,"ops":[],"note":"axis-aligned square that means equal horizontal and vertical distance."},{"line":13,"ops":[["set",["c1"],1]],"note":"looking up. Multiplying the three counts handles duplicate points."},{"line":14,"ops":[["set",["c2"],1]],"note":null},{"line":15,"ops":[["set",["total"],1]],"note":null},{"line":8,"ops":[],"note":null},{"line":16,"ops":[],"note":null}]},{"id":"edge","label":"No square","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["points"],[[0,0],[2,2],[0,2]]],["set",["query"],[4,4]]],"note":null},{"line":1,"ops":[["set",["counts"],{}]],"note":null},{"line":2,"ops":[["set",["p"],[0,0]]],"note":null},{"line":3,"ops":[["set",["key"],"0,0"]],"note":null},{"line":4,"ops":[["set",["counts","0,0"],1]],"note":null},{"line":2,"ops":[["set",["p",0],2],["set",["p",1],2]],"note":null},{"line":3,"ops":[["set",["key"],"2,2"]],"note":null},{"line":4,"ops":[["set",["counts","2,2"],1]],"note":null},{"line":2,"ops":[["set",["p",0],0]],"note":null},{"line":3,"ops":[["set",["key"],"0,2"]],"note":null},{"line":4,"ops":[["set",["counts","0,2"],1]],"note":null},{"line":2,"