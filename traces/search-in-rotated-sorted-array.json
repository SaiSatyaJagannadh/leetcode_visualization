{"schemaVersion":1,"slug":"search-in-rotated-sorted-array","title":"Search in Rotated Sorted Array","pattern":"Binary Search","difficulty":"Medium","leetcode":33,"prompt":"A sorted array of distinct values has been rotated. Return the index of a target, or -1 if it isn't present, in logarithmic time.","examples":[{"input":"nums = [4,5,6,7,0,1,2], target = 0","output":"4"},{"input":"nums = [4,5,6,7,0,1,2], target = 3","output":"-1"}],"constraints":["1 <= len(nums) <= 5000","All values distinct"],"approaches":[{"id":"binary","label":"Binary search the clean half","complexity":{"time":"O(log n)","space":"O(1)"},"viz":{"nums":"array","lo":"pointer:nums","hi":"pointer:nums","mid":"pointer:nums"},"layout":{},"source":["def binary(nums, target):","    lo, hi = 0, len(nums) - 1","    while lo <= hi:","        mid = (lo + hi) // 2","        if nums[mid] == target:","            return mid","        if nums[lo] <= nums[mid]:","            if nums[lo] <= target < nums[mid]:","                hi = mid - 1","            else:","                lo = mid + 1","        else:","            if nums[mid] < target <= nums[hi]:","                lo = mid + 1","            else:","                hi = mid - 1","    return -1"],"variants":[{"id":"typical","label":"Found","note":null,"result":4,"steps":[{"line":0,"ops":[["set",["nums"],[4,5,6,7,0,1,2]],["set",["target"],0]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],6]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],3]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this range\" test applies."},{"line":7,"ops":[],"note":"Left half is clean."},{"line":10,"ops":[["set",["lo"],4]],"note":"So it must be in the messy half."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],5]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this range\" test applies."},{"line":7,"ops":[],"note":"Left half is clean."},{"line":8,"ops":[["set",["hi"],4]],"note":"Target lies inside the clean half."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],4]],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]},{"id":"edge","label":"Missing","note":null,"result":-1,"steps":[{"line":0,"ops":[["set",["nums"],[4,5,6,7,0,1,2]],["set",["target"],3]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],6]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],3]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this range\" test applies."},{"line":7,"ops":[],"note":"Left half is clean."},{"line":10,"ops":[["set",["lo"],4]],"note":"So it must be in the messy half."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],5]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this range\" test applies."},{"line":7,"ops":[],"note":"Left half is clean."},{"line":10,"ops":[["set",["lo"],6]],"note":"So it must be in the messy half."},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],6]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this range\" test applies."},{"line":7,"ops":[],"note":"Left half is clean."},{"line":10,"ops":[["set",["lo"],7]],"note":"So it must be in the messy half."},{"line":2,"ops":[],"note":null},{"line":16,"ops":[],"note":null}]},{"id":"worst-case","label":"First element","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["nums"],[5,1,2,3,4]],["set",["target"],5]],"note":null},{"line":1,"ops":[["set",["lo"],0],["set",["hi"],4]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["mid"],2]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":"and then the ordinary \"is the target inside this