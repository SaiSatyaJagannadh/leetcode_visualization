{"schemaVersion":1,"slug":"non-overlapping-intervals","title":"Non-Overlapping Intervals","pattern":"Intervals","difficulty":"Medium","leetcode":435,"prompt":"Return the fewest intervals you must delete so that none of the survivors overlap.","examples":[{"input":"intervals = [[1,2],[2,3],[3,4],[1,3]]","output":"1"},{"input":"intervals = [[1,2],[1,2],[1,2]]","output":"2"}],"constraints":["1 <= len(intervals) <= 10^5"],"approaches":[{"id":"longest-chain","label":"Keep the longest chain","complexity":{"time":"O(n\u00b2)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","keep":"array","i":"pointer:keep","j":"pointer:keep"},"layout":{},"source":["def longest_chain(intervals):","    spans = sorted(intervals, key=lambda s: s[0])","    keep = [1] * len(spans)","    best = 0","    for i in range(len(spans)):","        for j in range(i):","            if spans[j][1] <= spans[i][0] and keep[j] + 1 > keep[i]:","                keep[i] = keep[j] + 1","        if keep[i] > best:","            best = keep[i]","    return len(spans) - best"],"variants":[{"id":"typical","label":"Delete one","note":null,"result":1,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[2,3],[3,4],[1,3]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[1,3],[2,3],[3,4]]]],"note":"increasing chain, which is the same problem wearing a different hat."},{"line":2,"ops":[["set",["keep"],[1,1,1,1]]],"note":null},{"line":3,"ops":[["set",["best"],0]],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],1]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":7,"ops":[["set",["keep",2],2]],"note":null},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],2]],"note":null},{"line":4,"ops":[["set",["i"],3]],"note":null},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":7,"ops":[["set",["keep",3],2]],"note":null},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[["set",["j"],2]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":7,"ops":[["set",["keep",3],3]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],3]],"note":null},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":"Everything not in the longest keepable chain has to go."}]},{"id":"edge","label":"All identical","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[1,2],[1,2]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[1,2],[1,2]]]],"note":"increasing chain, which is the same problem wearing a different hat."},{"line":2,"ops":[["set",["keep"],[1,1,1]]],"note":null},{"line":3,"ops":[["set",["best"],0]],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],1]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":"Everything not in the longest keepable chain has to go."}]},{"id":"worst-case","label":"Already clean","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[3,4]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[3,4]]]],"note":"increasing chain, which is the same problem wearing a different hat."},{"line":2,"ops":[["set",["keep"],[1,1]]],"note":null},{"line":3,"ops":[["set",["best"],0]],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],1]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[],"note":"span j can precede span i only if it finishes before i begins."},{"line":7,"ops":[["set",["keep",1],2]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["best"],2]],"note":null},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":"Everything not in the longest keepable chain has to go."}]}]},{"id":"earliest-end","label":"Keep the earliest finisher","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","span":"interval"},"layout":{},"source":["def keep_earliest_ends(intervals):","    spans = sorted(intervals, key=lambda s: s[1])","    removed = 0","    last_end = None","    for span in spans:","        if last_end is None or span[0] >= last_end:","            last_end = span[1]","        else:","            removed += 1","    return removed"],"variants":[{"id":"typical","label":"