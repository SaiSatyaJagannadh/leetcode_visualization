,"note":"earlier-ending one we already kept."},{"line":4,"ops":[],"note":null},{"line":9,"ops":[],"note":null}]},{"id":"worst-case","label":"Already clean","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[3,4]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[3,4]]]],"note":"one very long interval crowd out several short ones."},{"line":2,"ops":[["set",["removed"],0]],"note":null},{"line":3,"ops":[["set",["last_end"],null]],"note":null},{"line":4,"ops":[["set",["span"],[1,2]]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],2]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[["set",["span",0],3],["set",["span",1],4]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],4]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[],"note":null},{"line":9,"ops":[],"note":null}]}]}]}