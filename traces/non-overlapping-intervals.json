{"schemaVersion":1,"slug":"non-overlapping-intervals","title":"Non-Overlapping Intervals","pattern":"Intervals","difficulty":"Medium","leetcode":435,"prompt":"Return the fewest intervals you must delete so that none of the survivors overlap.","examples":[{"input":"intervals = [[1,2],[2,3],[3,4],[1,3]]","output":"1"},{"input":"intervals = [[1,2],[1,2],[1,2]]","output":"2"}],"constraints":["1 <= len(intervals) <= 10^5"],"approaches":[{"id":"earliest-end","label":"Keep the earliest finisher","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","span":"interval"},"layout":{},"source":["def keep_earliest_ends(intervals):","    spans = sorted(intervals, key=lambda s: s[1])","    removed = 0","    last_end = None","    for span in spans:","        if last_end is None or span[0] >= last_end:","            last_end = span[1]","        else:","            removed += 1","    return removed"],"variants":[{"id":"typical","label":"Delete one","note":null,"result":1,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[2,3],[3,4],[1,3]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[2,3],[1,3],[3,4]]]],"note":"one very long interval crowd out several short ones."},{"line":2,"ops":[["set",["removed"],0]],"note":null},{"line":3,"ops":[["set",["last_end"],null]],"note":null},{"line":4,"ops":[["set",["span"],[1,2]]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],2]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[["set",["span",0],2],["set",["span",1],3]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],3]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[["set",["span",0],1]],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[["set",["removed"],1]],"note":"earlier-ending one we already kept."},{"line":4,"ops":[["set",["span",0],3],["set",["span",1],4]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],4]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[],"note":null},{"line":9,"ops":[],"note":null}]},{"id":"edge","label":"All identical","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[1,2],[1,2]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[1,2],[1,2]]]],"note":"one very long interval crowd out several short ones."},{"line":2,"ops":[["set",["removed"],0]],"note":null},{"line":3,"ops":[["set",["last_end"],null]],"note":null},{"line":4,"ops":[["set",["span"],[1,2]]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],2]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[["set",["removed"],1]],"note":"earlier-ending one we already kept."},{"line":4,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":8,"ops":[["set",["removed"],2]],"note":"earlier-ending one we already kept."},{"line":4,"ops":[],"note":null},{"line":9,"ops":[],"note":null}]},{"id":"worst-case","label":"Already clean","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[3,4]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,2],[3,4]]]],"note":"one very long interval crowd out several short ones."},{"line":2,"ops":[["set",["removed"],0]],"note":null},{"line":3,"ops":[["set",["last_end"],null]],"note":null},{"line":4,"ops":[["set",["span"],[1,2]]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],2]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[["set",["span",0],3],["set",["span",1],4]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["last_end"],4]],"note":"Fits after the last one we kept, so keep it too."},{"line":4,"ops":[],"note":null},{"line":9,"ops":[],"note":null}]}]}]}