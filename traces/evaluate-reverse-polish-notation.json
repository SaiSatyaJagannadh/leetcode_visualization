{"schemaVersion":1,"slug":"evaluate-reverse-polish-notation","title":"Evaluate Reverse Polish Notation","pattern":"Stack","difficulty":"Medium","leetcode":150,"prompt":"Evaluate an arithmetic expression written in postfix form, where each operator follows its two operands. Division truncates toward zero.","examples":[{"input":"tokens = [\"2\",\"1\",\"+\",\"3\",\"*\"]","output":"9","why":"(2 + 1) * 3."},{"input":"tokens = [\"4\",\"13\",\"5\",\"/\",\"+\"]","output":"6","why":"4 + (13 / 5) = 4 + 2."}],"constraints":["1 <= len(tokens) <= 10^4","The expression is always valid"],"approaches":[{"id":"stack","label":"Stack","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"stack":"stack","tokens":"array"},"layout":{},"source":["def with_stack(tokens):","    stack = []","    for tok in tokens:","        if tok not in OPS:","            stack.append(int(tok))","            continue","        right = stack.pop()","        left = stack.pop()","        if tok == \"+\":","            stack.append(left + right)","        elif tok == \"-\":","            stack.append(left - right)","        elif tok == \"*\":","            stack.append(left * right)","        else:","            stack.append(int(left / right))","    return stack[0]"],"variants":[{"id":"typical","label":"Typical","note":null,"result":9,"steps":[{"line":0,"note":null,"ops":[["set",["tokens"],["2","1","+","3","*"]]]},{"line":1,"note":"Postfix needs no brackets because the stack remembers what is still pending.","ops":[["set",["stack"],[]]]},{"line":2,"note":null,"ops":[["set",["tok"],"2"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["stack"],[2]]]},{"line":5,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["tok"],"1"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["stack"],[2,1]]]},{"line":5,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["tok"],"+"]]},{"line":3,"note":null,"ops":[]},{"line":6,"note":"second one popped is the left-hand side.","ops":[["set",["stack"],[2]],["set",["right"],1]]},{"line":7,"note":null,"ops":[["set",["stack"],[]],["set",["left"],2]]},{"line":8,"note":null,"ops":[]},{"line":9,"note":null,"ops":[["set",["stack"],[3]]]},{"line":2,"note":null,"ops":[["set",["tok"],"3"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["stack"],[3,3]]]},{"line":5,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["tok"],"*"]]},{"line":3,"note":null,"ops":[]},{"line":6,"note":"second one popped is the left-hand side.","ops":[["set",["stack"],[3]],["set",["right"],3]]},{"line":7,"note":null,"ops":[["set",["stack"],[]],["set",["left"],3]]},{"line":8,"note":null,"ops":[]},{"line":10,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":13,"note":null,"ops":[["set",["stack"],[9]]]},{"line":2,"note":null,"ops":[]},{"line":16,"note":"A valid expression leaves exactly one value behind.","ops":[]}]},{"id":"edge","label":"Single number","note":null,"result":42,"steps":[{"line":0,"note":null,"ops":[["set",["tokens"],["42"]]]},{"line":1,"note":"Postfix needs no brackets because the stack remembers what is still pending.","ops":[["set",["stack"],[]]]},{"line":2,"note":null,"ops":[["set",["tok"],"42"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["stack"],[42]]]},{"line":5,"note":null,"ops":[]},{"line":2,"note":null,"ops":[]},{"line":16,"note":"A valid expression leaves exactly one value behind.","ops":[]}]},{"id":"worst-case","label":"Truncating division","note":null,"result":6,"steps":[{"line":0,"note":null,"ops":[["set",["tokens"],["4","13","5","/","+"]]]},{"line":1,"note":"Postfix needs no brackets because the stack remembers what is still pending.","ops":[["set",["stack"],[]]]},{"line":2,"note":null,"ops":[["set",["tok"],"4"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[["set",["stack"],[4]]]},{"line":5,"note":null,"ops":[]},{"line":2,"note":null,"ops":[["set",["tok"],"13"]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,