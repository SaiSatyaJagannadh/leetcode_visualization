{"schemaVersion":1,"slug":"evaluate-reverse-polish-notation","title":"Evaluate Reverse Polish Notation","pattern":"Stack","difficulty":"Medium","leetcode":150,"prompt":"Evaluate an arithmetic expression written in postfix form, where each operator follows its two operands. Division truncates toward zero.","examples":[{"input":"tokens = [\"2\",\"1\",\"+\",\"3\",\"*\"]","output":"9","why":"(2 + 1) * 3."},{"input":"tokens = [\"4\",\"13\",\"5\",\"/\",\"+\"]","output":"6","why":"4 + (13 / 5) = 4 + 2."}],"constraints":["1 <= len(tokens) <= 10^4","The expression is always valid"],"approaches":[{"id":"stack","label":"Stack","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"stack":"stack","tokens":"array"},"layout":{},"source":["def with_stack(tokens):","    stack = []","    for tok in tokens:","        if tok not in OPS:","            stack.append(int(tok))","            continue","        right = stack.pop()","        left = stack.pop()","        if tok == \"+\":","            stack.append(left + right)","        elif tok == \"-\":","            stack.append(left - right)","        elif tok == \"*\":","            stack.append(left * right)","        else:","            stack.append(int(left / right))","    return stack[0]"],"variants":[{"id":"typical","label":"Typical","note":null,"result":9,"steps":[{"line":0,"ops":[["set",["tokens"],["2","1","+","3","*"]]],"note":null},{"line":1,"ops":[["set",["stack"],[]]],"note":"Postfix needs no brackets because the stack remembers what is still pending."},{"line":2,"ops":[["set",["tok"],"2"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[2]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"1"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[2,1]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"+"]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["stack"],[2]],["set",["right"],1]],"note":"second one popped is the left-hand side."},{"line":7,"ops":[["set",["stack"],[]],["set",["left"],2]],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["stack"],[3]]],"note":null},{"line":2,"ops":[["set",["tok"],"3"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[3,3]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"*"]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["stack"],[3]],["set",["right"],3]],"note":"second one popped is the left-hand side."},{"line":7,"ops":[["set",["stack"],[]],["set",["left"],3]],"note":null},{"line":8,"ops":[],"note":null},{"line":10,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":13,"ops":[["set",["stack"],[9]]],"note":null},{"line":2,"ops":[],"note":null},{"line":16,"ops":[],"note":"A valid expression leaves exactly one value behind."}]},{"id":"edge","label":"Single number","note":null,"result":42,"steps":[{"line":0,"ops":[["set",["tokens"],["42"]]],"note":null},{"line":1,"ops":[["set",["stack"],[]]],"note":"Postfix needs no brackets because the stack remembers what is still pending."},{"line":2,"ops":[["set",["tok"],"42"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[42]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":16,"ops":[],"note":"A valid expression leaves exactly one value behind."}]},{"id":"worst-case","label":"Truncating division","note":null,"result":6,"steps":[{"line":0,"ops":[["set",["tokens"],["4","13","5","/","+"]]],"note":null},{"line":1,"ops":[["set",["stack"],[]]],"note":"Postfix needs no brackets because the stack remembers what is still pending."},{"line":2,"ops":[["set",["tok"],"4"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[4]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"13"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[4,13]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"5"]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["stack"],[4,13,5]]],"note":null},{"line":5,"ops":[],"note":null},{"line":2,"ops":[["set",["tok"],"/"]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["stack"],[4,13]],["set",["right"],5]],"note":"second one popped is the left-hand side."},{"line":7,"ops":[["set",["stack"],[4]],["set",["left"],13]],"note":null},{"line":8,"ops":[],"note":null},{"line":10,"ops":[],"note":null},{"line":12,"ops":[],"note":null},{"line":15,"ops":[["set",["stack"],[4,2]]],"note":"int() truncates toward zero; Python's // would floor toward -inf."},{"line":2,"ops":[["set",["tok"],"+"]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["stack"],[4]],["set",["right"],2]],"note":"second one popped is the left-hand side."},{"line":7,"ops":[["set",["stack"],[]],["set",["left"],4]],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["stack"],[6]]],"note":null},{"line":2,"ops":[],"note":null},{"line":16,"ops":[],"note":"A valid expression leaves exactly one value behind."}]}]}]}