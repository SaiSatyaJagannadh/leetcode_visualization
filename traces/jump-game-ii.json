{"schemaVersion":1,"slug":"jump-game-ii","title":"Jump Game II","pattern":"Greedy","difficulty":"Medium","leetcode":45,"prompt":"The last index is always reachable. Return the fewest jumps needed to get there from index 0.","examples":[{"input":"nums = [2,3,1,1,4]","output":"2","why":"Jump to index 1, then to the end."},{"input":"nums = [2,3,0,1,4]","output":"2"}],"constraints":["1 <= len(nums) <= 10^4","The end is always reachable"],"approaches":[{"id":"levels","label":"One jump per level","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","i":"pointer:nums","edge":"pointer:nums","furthest":"pointer:nums"},"layout":{},"source":["def level_by_level(nums):","    jumps = 0","    edge = 0","    furthest = 0","    for i in range(len(nums) - 1):","        if i + nums[i] > furthest:","            furthest = i + nums[i]","        if i == edge:","            jumps += 1","            edge = furthest","    return jumps"],"variants":[{"id":"typical","label":"Typical","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[2,3,1,1,4]]],"note":null},{"line":1,"ops":[["set",["jumps"],0]],"note":"everything reachable in two is the next, and so on."},{"line":2,"ops":[["set",["edge"],0]],"note":"Where the current level ends."},{"line":3,"ops":[["set",["furthest"],0]],"note":"Furthest anything in the current level can reach."},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["furthest"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["jumps"],1]],"note":"Ran out of the current level, so a jump is unavoidable here."},{"line":9,"ops":[["set",["edge"],2]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["furthest"],4]],"note":null},{"line":7,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["jumps"],2]],"note":"Ran out of the current level, so a jump is unavoidable here."},{"line":9,"ops":[["set",["edge"],4]],"note":null},{"line":4,"ops":[["set",["i"],3]],"note":null},{"line":5,"ops":[],"note":null},{"line":7,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":null}]},{"id":"edge","label":"Single element","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["nums"],[0]]],"note":null},{"line":1,"ops":[["set",["jumps"],0]],"note":"everything reachable in two is the next, and so on."},{"line":2,"ops":[["set",["edge"],0]],"note":"Where the current level ends."},{"line":3,"ops":[["set",["furthest"],0]],"note":"Furthest anything in the current level can reach."},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":null}]},{"id":"worst-case","label":"One step at a time","note":null,"result":3,"steps":[{"line":0,"ops":[["set",["nums"],[1,1,1,1]]],"note":null},{"line":1,"ops":[["set",["jumps"],0]],"note":"everything reachable in two is the next, and so on."},{"line":2,"ops":[["set",["edge"],0]],"note":"Where the current level ends."},{"line":3,"ops":[["set",["furthest"],0]],"note":"Furthest anything in the current level can reach."},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["furthest"],1]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["jumps"],1]],"note":"Ran out of the current level, so a jump is unavoidable here."},{"line":9,"ops":[["set",["edge"],1]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["furthest"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["jumps"],2]],"note":"Ran out of the current level, so a jump is unavoidable here."},{"line":9,"ops":[["set",["edge"],2]],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["furthest"],3]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["jumps"],3]],"note":"Ran out of the current level, so a jump is unavoidable here."},{"line":9,"ops":[["set",["edge"],3]],"note":null},{"line":4,"ops":[],"note":null},{"line":10,"ops":[],"note":null}]}]}]}