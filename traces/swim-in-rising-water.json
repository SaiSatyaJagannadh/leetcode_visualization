{"schemaVersion":1,"slug":"swim-in-rising-water","title":"Swim in Rising Water","pattern":"Advanced Graphs","difficulty":"Hard","leetcode":778,"prompt":"Water rises over a grid of heights. You may move to a neighbouring cell once the water level is at least as high as both cells. Return the earliest time you can reach the bottom-right corner from the top-left.","examples":[{"input":"grid = [[0,2],[1,3]]","output":"3"},{"input":"grid = [[0,1,2],[3,4,5],[6,7,8]]","output":"8"}],"constraints":["1 <= n <= 50","Heights are a permutation of 0 .. n\u00b2-1"],"approaches":[{"id":"widest","label":"Dijkstra on the path maximum","complexity":{"time":"O(n\u2074)","space":"O(n\u00b2)"},"viz":{"grid":"grid","best":"grid","pr":"row:best","pc":"col:best"},"layout":{},"source":["def widest_path(grid):","    n = len(grid)","    best = [[BIG] * n for _ in range(n)]","    best[0][0] = grid[0][0]","    done = {}","    while True:","        pr, pc, pv = -1, -1, BIG","        for r in range(n):","            for c in range(n):","                key = str(r) + \",\" + str(c)","                if key not in done and best[r][c] < pv:","                    pr, pc, pv = r, c, best[r][c]","        if pr == -1:","            break","        done[str(pr) + \",\" + str(pc)] = True","        for d in ([1, 0], [-1, 0], [0, 1], [0, -1]):","            nr, nc = pr + d[0], pc + d[1]","            if 0 <= nr < n and 0 <= nc < n:","                need = max(pv, grid[nr][nc])","                if need < best[nr][nc]:","                    best[nr][nc] = need","    return best[n - 1][n - 1]"],"variants":[{"id":"typical","label":"2 x 2","note":null,"result":3,"steps":[{"line":0,"note":null,"ops":[["set",["grid"],[[0,2],[1,3]]]]},{"line":1,"note":null,"ops":[["set",["n"],2]]},{"line":2,"note":"cell \u2014 the moment the water first got high enough to clear every step.","ops":[]},{"line":2,"note":"cell \u2014 the moment the water first got high enough to clear every step.","ops":[]},{"line":2,"note":"cell \u2014 the moment the water first got high enough to clear every step.","ops":[["set",["best"],[[1000000000,1000000000],[1000000000,1000000000]]]]},{"line":3,"note":null,"ops":[["set",["best",0,0],0]]},{"line":4,"note":null,"ops":[["set",["done"],{}]]},{"line":5,"note":null,"ops":[]},{"line":6,"note":"Settle the reachable cell with the lowest required water level.","ops":[["set",["pr"],-1],["set",["pc"],-1],["set",["pv"],1000000000]]},{"line":7,"note":null,"ops":[["set",["r"],0]]},{"line":8,"note":null,"ops":[["set",["c"],0]]},{"line":9,"note":null,"ops":[["set",["key"],"0,0"]]},{"line":10,"note":null,"ops":[]},{"line":11,"note":null,"ops":[["set",["pr"],0],["set",["pc"],0],["set",["pv"],0]]},{"line":8,"note":null,"ops":[["set",["c"],1]]},{"line":9,"note":null,"ops":[["set",["key"],"0,1"]]},{"line":10,"note":null,"ops":[]},{"line":8,"note":null,"ops":[]},{"line":7,"note":null,"ops":[["set",["r"],1]]},{"line":8,"note":null,"ops":[["set",["c"],0]]},{"line":9,"note":null,"ops":[["set",["key"],"1,0"]]},{"line":10,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["c"],1]]},{"line":9,"note":null,"ops":[["set",["key"],"1,1"]]},{"line":10,"note":null,"ops":[]},{"line":8,"note":null,"ops":[]},{"line":7,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]},{"line":14,"note":null,"ops":[["set",["done","0,0"],true]]},{"line":15,"note":null,"ops":[["set",["d"],[1,0]]]},{"line":16,"note":null,"ops":[["set",["nr"],1],["set",["nc"],0]]},{"line":17,"note":null,"ops":[]},{"line":18,"note":"Stepping there needs the water at least as high as both cells.","ops":[["set",["need"],1]]},{"line":19,"note":null,"ops":[]},{"line":20,"note":null,"ops":[["set",["best",1,0],1]]},{"line":15,"note":null,"ops":[["set",["d",0],-1]]},{"line":16,"note":null,"ops":[["set",["nr"],-1]]},{"line":17,"note":null,"ops":[]},{"line":15,"note":null,"ops":[["set",["d",0],0],["set",["d",1],1]]},{"line":16,"note":null,"ops":[["set",["nr"],0],["set",["nc"],1]]},{"line":17,"note":null,"ops":[]},{"line":18,"no