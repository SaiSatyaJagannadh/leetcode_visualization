{"schemaVersion":1,"slug":"rotate-image","title":"Rotate Image","pattern":"Math & Geometry","difficulty":"Medium","leetcode":48,"prompt":"Rotate a square matrix ninety degrees clockwise, modifying it in place rather than building a new one.","examples":[{"input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","output":"[[7,4,1],[8,5,2],[9,6,3]]"},{"input":"matrix = [[1,2],[3,4]]","output":"[[3,1],[4,2]]"}],"constraints":["1 <= n <= 20","Must be done in place"],"approaches":[{"id":"cycle","label":"Rotate four cells at a time","complexity":{"time":"O(n\u00b2)","space":"O(1)"},"viz":{"matrix":"grid","layer":"row:matrix","i":"col:matrix"},"layout":{},"source":["def four_way_cycle(matrix):","    n = len(matrix)","    for layer in range(n // 2):","        last = n - 1 - layer","        for i in range(layer, last):","            offset = i - layer","            top = matrix[layer][i]","            matrix[layer][i] = matrix[last - offset][layer]","            matrix[last - offset][layer] = matrix[last][last - offset]","            matrix[last][last - offset] = matrix[i][last]","            matrix[i][last] = top","    return matrix"],"variants":[{"id":"typical","label":"3 x 3","note":null,"result":[[7,4,1],[8,5,2],[9,6,3]],"steps":[{"line":0,"ops":[["set",["matrix"],[[1,2,3],[4,5,6],[7,8,9]]]],"note":null},{"line":1,"ops":[["set",["n"],3]],"note":"instead of the two full passes the transpose-and-flip makes."},{"line":2,"ops":[["set",["layer"],0]],"note":null},{"line":3,"ops":[["set",["last"],2]],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[["set",["offset"],0]],"note":null},{"line":6,"ops":[["set",["top"],1]],"note":"travelling anticlockwise so the values land clockwise."},{"line":7,"ops":[["set",["matrix",0,0],7]],"note":null},{"line":8,"ops":[["set",["matrix",2,0],9]],"note":null},{"line":9,"ops":[["set",["matrix",2,2],3]],"note":null},{"line":10,"ops":[["set",["matrix",0,2],1]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["offset"],1]],"note":null},{"line":6,"ops":[["set",["top"],2]],"note":"travelling anticlockwise so the values land clockwise."},{"line":7,"ops":[["set",["matrix",0,1],4]],"note":null},{"line":8,"ops":[["set",["matrix",1,0],8]],"note":null},{"line":9,"ops":[["set",["matrix",2,1],6]],"note":null},{"line":10,"ops":[["set",["matrix",1,2],2]],"note":null},{"line":4,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]},{"id":"edge","label":"Single cell","note":null,"result":[[1]],"steps":[{"line":0,"ops":[["set",["matrix"],[[1]]]],"note":null},{"line":1,"ops":[["set",["n"],1]],"note":"instead of the two full passes the transpose-and-flip makes."},{"line":2,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]},{"id":"worst-case","label":"2 x 2","note":null,"result":[[3,1],[4,2]],"steps":[{"line":0,"ops":[["set",["matrix"],[[1,2],[3,4]]]],"note":null},{"line":1,"ops":[["set",["n"],2]],"note":"instead of the two full passes the transpose-and-flip makes."},{"line":2,"ops":[["set",["layer"],0]],"note":null},{"line":3,"ops":[["set",["last"],1]],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[["set",["offset"],0]],"note":null},{"line":6,"ops":[["set",["top"],1]],"note":"travelling anticlockwise so the values land clockwise."},{"line":7,"ops":[["set",["matrix",0,0],3]],"note":null},{"line":8,"ops":[["set",["matrix",1,0],4]],"note":null},{"line":9,"ops":[["set",["matrix",1,1],2]],"note":null},{"line":10,"ops":[["set",["matrix",0,1],1]],"note":null},{"line":4,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]}]},{"id":"transpose-flip","label":"Transpose, then reverse rows","complexity":{"time":"O(n\u00b2)","space":"O(1)"},"viz":{"matrix":"grid","r":"row:matrix","c":"col:matrix"},"layout":{},"source":["def transpose_then_flip(matrix):","    n = len(matrix)","    for r in range(n):","        for c in range(r + 1, n):","            matrix[r][c], matrix[c][r] = matrix[c][r], matrix[r][c]","    for r in range(n):","        matrix[r].reverse()","    return matrix"],"variants":[{"id":"typical","label":"3 x 3","note":null,"result":[[7,4,1],[8,5,2],[9,6,3]],"steps":[{"line":0,"ops":[["set",["matrix"],[[1,2,3],[4,5,6],[7,8,9]]]],"note":null},{"line":1,"ops":[["set",["n"],3]],"note":null},{"line":2,"ops":[["set",["r"],0]],"note":"a rotation with the wrong handedness."},{"line":3,"ops":[["set",["c"],1]],"note":null},{"line":4,"ops":[["set",["matrix",0,1],4],["set",["matrix",1,0],2]],"note":null},{"line":3,"ops":[["set",["c"],2]],"note":null},{"line":4,"ops":[["set",["matrix",0,2],7],["set",["matrix",2,0],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["r"],1]],"note":"a rotation with the wrong handedness."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["matrix",1,2],8],["set",["matrix",2,1],6]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[["set",["r"],2]],"note":"a rotation with the wrong handedness."},{"line":3,"ops":[],"note":null},{"line":2,"ops":[],"note":"a rotation with the wrong handedness."},{"line":5,"ops":[["set",["r"],0]],"note":"reflections together are exactly a quarter turn clockwise."},{"line":6,"ops":[["set",["matrix",0,0],7],["set",["matrix",0,2],1]],"note":null},{"line":5,"ops":[["set",["r"],1]],"note":"reflections together are exactly a quarter turn clockwise."},{"line":6,"ops":[["set",["matrix",1,0],8],["set",["matrix",1,2],2]],"note":null},{"line":5,"ops":[["set",["r"],2]],"note":"reflections together are exactly a quarter turn clockwise."},{"line":6,"ops":[["set",["matrix",2,0],9],["set",["matrix",2,2],3]],"note":null},{"line":5,"ops":[],"note":"reflections together are exactly a quarter turn clockwise."},{"line":7,"ops":[],"note":null}]},{"id":"edge","label":"Single cell","note":null,"result":[[1]],"steps":[{"line":0,"ops":[["set",["matrix"],[[1]]]],"note":null},{"line":1,"ops":[["set",["n"],1]],"note":null},{"line":2,"ops":[["set",["r"],0]],"note":"a rotation with 