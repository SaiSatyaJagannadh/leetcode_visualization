{"schemaVersion":1,"slug":"longest-increasing-path-in-a-matrix","title":"Longest Increasing Path in a Matrix","pattern":"2-D Dynamic Programming","difficulty":"Hard","leetcode":329,"prompt":"Find the longest path through the grid where each step moves to a horizontally or vertically adjacent cell holding a strictly larger value.","examples":[{"input":"matrix = [[9,9,4],[6,6,8],[2,1,1]]","output":"4","why":"1 \u2192 2 \u2192 6 \u2192 9."},{"input":"matrix = [[1]]","output":"1"}],"constraints":["1 <= rows, cols <= 200"],"approaches":[{"id":"memo","label":"DFS with memoisation","complexity":{"time":"O(rc)","space":"O(rc)"},"viz":{"matrix":"grid","memo":"grid","$calls":"recursion"},"layout":{},"source":["def memoised(matrix):","    rows, cols = len(matrix), len(matrix[0])","    memo = [[0] * cols for _ in range(rows)]","    best = 0","    for r in range(rows):","        for c in range(cols):","            best = max(best, _walk(matrix, r, c, memo))","    return best"],"variants":[{"id":"typical","label":"Typical","note":null,"result":4,"steps":[{"line":0,"note":null,"ops":[["set",["matrix"],[[9,9,4],[6,6,8],[2,1,1]]]]},{"line":1,"note":null,"ops":[["set",["rows"],3],["set",["cols"],3]]},{"line":2,"note":"and each cell's answer is fixed \u2014 which is what makes memoising valid.","ops":[]},{"line":2,"note":"and each cell's answer is fixed \u2014 which is what makes memoising valid.","ops":[]},{"line":2,"note":"and each cell's answer is fixed \u2014 which is what makes memoising valid.","ops":[]},{"line":2,"note":"and each cell's answer is fixed \u2014 which is what makes memoising valid.","ops":[["set",["memo"],[[0,0,0],[0,0,0],[0,0,0]]]]},{"line":3,"note":null,"ops":[["set",["best"],0]]},{"line":4,"note":null,"ops":[["set",["r"],0]]},{"line":5,"note":null,"ops":[["set",["c"],0]]},{"line":6,"note":null,"ops":[["set",["memo",0,0],1],["set",["best"],1]]},{"line":5,"note":null,"ops":[["set",["c"],1]]},{"line":6,"note":null,"ops":[["set",["memo",0,1],1]]},{"line":5,"note":n