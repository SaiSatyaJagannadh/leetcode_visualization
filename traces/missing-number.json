{"schemaVersion":1,"slug":"missing-number","title":"Missing Number","pattern":"Bit Manipulation","difficulty":"Easy","leetcode":268,"prompt":"An array holds n distinct values drawn from 0 to n. Return the one value that isn't there.","examples":[{"input":"nums = [3,0,1]","output":"2"},{"input":"nums = [0,1]","output":"2","why":"The missing value can be n itself."}],"constraints":["1 <= n <= 10^4","All values distinct"],"approaches":[{"id":"sum","label":"Compare against the expected sum","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array"},"layout":{},"source":["def by_sum(nums):","    n = len(nums)","    expected = n * (n + 1) // 2","    actual = 0","    for v in nums:","        actual += v","    return expected - actual"],"variants":[{"id":"typical","label":"Missing in the middle","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[3,0,1]]],"note":null},{"line":1,"ops":[["set",["n"],3]],"note":"The full range has a known total, so the gap is whatever the array lacks."},{"line":2,"ops":[["set",["expected"],6]],"note":null},{"line":3,"ops":[["set",["actual"],0]],"note":null},{"line":4,"ops":[["set",["v"],3]],"note":null},{"line":5,"ops":[["set",["actual"],3]],"note":null},{"line":4,"ops":[["set",["v"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["v"],1]],"note":null},{"line":5,"ops":[["set",["actual"],4]],"note":null},{"line":4,"ops":[],"note":null},{"line":6,"ops":[],"note":null}]},{"id":"edge","label":"Missing the largest","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[0,1]]],"note":null},{"line":1,"ops":[["set",["n"],2]],"note":"The full range has a known total, so the gap is whatever the array lacks."},{"line":2,"ops":[["set",["expected"],3]],"note":null},{"line":3,"ops":[["set",["actual"],0]],"note":null},{"line":4,"ops":[["set",["v"],0]],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["v"],1]],"note":null},{"line":5,"ops":[["set",["actual"],1]],"note":null},{"line"