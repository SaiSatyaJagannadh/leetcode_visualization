{"schemaVersion":1,"slug":"sum-of-two-integers","title":"Sum of Two Integers","pattern":"Bit Manipulation","difficulty":"Medium","leetcode":371,"prompt":"Add two integers without using the plus or minus operators.","examples":[{"input":"a = 1, b = 2","output":"3"},{"input":"a = 2, b = 3","output":"5"}],"constraints":["-1000 <= a, b <= 1000"],"approaches":[{"id":"xor-carry","label":"XOR for the sum, AND for the carry","complexity":{"time":"O(32)","space":"O(1)"},"viz":{},"layout":{},"source":["def xor_and_carry(a, b):","    x = a","    y = b","    while y != 0:","        carry = (x & y) << 1","        x = x ^ y","        y = carry","    return x"],"variants":[{"id":"typical","label":"No carry","note":null,"result":3,"steps":[{"line":0,"ops":[["set",["a"],1],["set",["b"],2]],"note":null},{"line":1,"ops":[["set",["x"],1]],"note":"where a carry was owed. Shifting that left by one puts it where it belongs."},{"line":2,"ops":[["set",["y"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],0]],"note":null},{"line":5,"ops":[["set",["x"],3]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],0]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":7,"ops":[],"note":null}]},{"id":"edge","label":"Zero","note":null,"result":5,"steps":[{"line":0,"ops":[["set",["a"],0],["set",["b"],5]],"note":null},{"line":1,"ops":[["set",["x"],0]],"note":"where a carry was owed. Shifting that left by one puts it where it belongs."},{"line":2,"ops":[["set",["y"],5]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],0]],"note":null},{"line":5,"ops":[["set",["x"],5]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],0]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":7,"ops":[],"note":null}]},{"id":"worst-case","label":"Carry chain","note":null,"result":16,"steps":[{"line":0,"ops":[["set",["a"],7],["set",["b"],9]],"note":null},{"line":1,"ops":[["set",["x"],7]],"note":"where a carry was owed. Shifting that left by one puts it where it belongs."},{"line":2,"ops":[["set",["y"],9]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],2]],"note":null},{"line":5,"ops":[["set",["x"],14]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],2]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],4]],"note":null},{"line":5,"ops":[["set",["x"],12]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],4]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],8]],"note":null},{"line":5,"ops":[["set",["x"],8]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],8]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],16]],"note":null},{"line":5,"ops":[["set",["x"],0]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],16]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["carry"],0]],"note":null},{"line":5,"ops":[["set",["x"],16]],"note":"The sum, ignoring carries."},{"line":6,"ops":[["set",["y"],0]],"note":"Now add the carries in, which may produce more carries."},{"line":3,"ops":[],"note":null},{"line":7,"ops":[],"note":null}]}]}]}