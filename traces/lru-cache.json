{"schemaVersion":1,"slug":"lru-cache","title":"LRU Cache","pattern":"Linked List","difficulty":"Medium","leetcode":146,"prompt":"A cache of fixed capacity. Reading or writing a key makes it the most recently used; when the cache is full, the least recently used key is evicted. Both operations must be constant time.","examples":[{"input":"capacity 2: put(1,1), put(2,2), get(1)","output":"1"},{"input":"put(3,3) then get(2)","output":"-1","why":"Key 2 was the least recently used, so it was evicted."}],"constraints":["1 <= capacity <= 3000","get and put must be O(1)"],"approaches":[{"id":"ordered","label":"Map plus recency order","complexity":{"time":"O(1) amortised","space":"O(capacity)"},"viz":{"store":"map","order":"queue","out":"queue"},"layout":{},"source":["def ordered_map(cap, ops):","    store = {}","    order = []","    out = []","    for op in ops:","        kind, key, value = op[0], op[1], op[2]","        if kind == \"get\":","            if key not in store:","                out.append(-1)","                continue","            order.remove(key)","            order.append(key)","            out.append(store[key])","        else:","            if key in store:","                order.remove(key)","            elif len(store) >= cap:","                victim = order.pop(0)","                del store[victim]","            store[key] = value","            order.append(key)","    return out"],"variants":[{"id":"typical","label":"Eviction","note":null,"result":[1,-1],"steps":[{"line":0,"ops":[["set",["cap"],2],["set",["ops"],[["put",1,1],["put",2,2],["get",1,0],["put",3,3],["get",2,0]]]],"note":null},{"line":1,"ops":[["set",["store"],{}]],"note":"a doubly linked list so the reorder below is O(1) rather than O(n)."},{"line":2,"ops":[["set",["order"],[]]],"note":null},{"line":3,"ops":[["set",["out"],[]]],"note":null},{"line":4,"ops":[["set",["op"],["put",1,1]]],"note":null},{"line":5,"ops":[["set",["kind"],"put"],["set",["key"],1],["set",["value"],1]],"note":null},{"line":6,"ops":[],"note":null},{"line":14,"ops":[],"note":null},{"line":16,"ops":[],"note":null},{"line":19,"ops":[["set",["store","1"],1]],"note":null},{"line":20,"ops":[["set",["order"],[1]]],"note":null},{"line":4,"ops":[["set",["op",1],2],["set",["op",2],2]],"note":null},{"line":5,"ops":[["set",["key"],2],["set",["value"],2]],"note":null},{"line":6,"ops":[],"note":null},{"line":14,"ops":[],"note":null},{"line":16,"ops":[],"note":null},{"line":19,"ops":[["set",["store","2"],2]],"note":null},{"line":20,"ops":[["set",["order"],[1,2]]],"note":null},{"line":4,"ops":[["set",["op",0],"get"],["set",["op",1],1],["set",["op",2],0]],"note":null},{"line":5,"ops":[["set",["kind"],"get"],["set",["key"],1],["set",["value"],0]],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":null},{"line":10,"ops":[["set",["order"],[2]]],"note":"A hit counts as use, so the key moves to the recent end."},{"line":11,"ops":[["set",["order"],[2,1]]],"note":null},{"line":12,"ops":[["set",["out"],[1]]],"note":null},{"line":4,"ops":[["set",["op",0],"put"],["set",["op",1],3],["set",["op",2],3]],"note":null},{"line":5,"ops":[["set",["kind"],"put"],["set",["key"],3],["set",["value"],3]],"note":null},{"line":6,"ops":[],"note":null},{"line":14,"ops":[],"note":null},{"line":16,"ops":[],"note":null},{"line":17,"ops":[["set",["order"],[1]],["set",["victim"],2]],"note":"Full and this is a new key, so the oldest one has to go."},{"line":18,"ops":[["del",["store","2"]]],"note":null},{"line":19,"ops":[["set",["store","3"],3]],"note":null},{"line":20,"ops":[["set",["order"],[1,3]]],"note":null},{"line":4,"ops":[["set",["op",0],"get"],["set",["op",1],2],["set",["op",2],0]],"note":null},{"line":5,"ops":[["set",["kind"],"get"],["set",["key"],2],["set",["value"],0]],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["out"],[1,-1]]],"note":null},{"line":9,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":21,"ops":[],"note":null}]}