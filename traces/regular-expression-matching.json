{"schemaVersion":1,"slug":"regular-expression-matching","title":"Regular Expression Matching","pattern":"2-D Dynamic Programming","difficulty":"Hard","leetcode":10,"prompt":"Match a string against a pattern where '.' matches any single character and '*' means zero or more of whatever precedes it. The match must cover the entire string.","examples":[{"input":"s = \"aab\", p = \"c*a*b\"","output":"true","why":"c* matches nothing, a* matches aa."},{"input":"s = \"mississippi\", p = \"mis*is*p*.\"","output":"false"}],"constraints":["1 <= len(s) <= 20","1 <= len(p) <= 20"],"approaches":[{"id":"table","label":"Fill the grid","complexity":{"time":"O(mn)","space":"O(mn)"},"viz":{"dp":"grid","i":"row:dp","j":"col:dp"},"layout":{},"source":["def table(s, p):","    dp = [[False] * (len(p) + 1) for _ in range(len(s) + 1)]","    dp[0][0] = True","    for j in range(1, len(p) + 1):","        if p[j - 1] == \"*\":","            dp[0][j] = dp[0][j - 2]","    for i in range(1, len(s) + 1):","        for j in range(1, len(p) + 1):","            if p[j - 1] == \"*\":","                dp[i][j] = dp[i][j - 2]","                if p[j - 2] == \".\" or p[j - 2] == s[i - 1]:","                    dp[i][j] = dp[i][j] or dp[i - 1][j]","            elif p[j - 1] == \".\" or p[j - 1] == s[i - 1]:","                dp[i][j] = dp[i - 1][j - 1]","    return dp[len(s)][len(p)]"],"variants":[{"id":"typical","label":"Star matches zero","note":null,"result":true,"steps":[{"line":0,"ops":[["set",["s"],"aab"],["set",["p"],"c*a*b"]],"note":null},{"line":1,"ops":[],"note":"dp[i][j] asks whether the first i of s match the first j of p."},{"line":1,"ops":[],"note":"dp[i][j] asks whether the first i of s match the first j of p."},{"line":1,"ops":[],"note":"dp[i][j] asks whether the first i of s match the first j of p."},{"line":1,"ops":[],"note":"dp[i][j] asks whether the first i of s match the first j of p."},{"line":1,"ops":[["set",["dp"],[[false,false,false,false,false,false],[false,false,false,false,fa