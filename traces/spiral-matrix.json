{"schemaVersion":1,"slug":"spiral-matrix","title":"Spiral Matrix","pattern":"Math & Geometry","difficulty":"Medium","leetcode":54,"prompt":"Return all elements of a matrix in spiral order: across the top row, down the right side, back along the bottom, up the left, then inward.","examples":[{"input":"matrix = [[1,2,3],[4,5,6],[7,8,9]]","output":"[1,2,3,6,9,8,7,4,5]"},{"input":"matrix = [[1,2,3]]","output":"[1,2,3]","why":"A single row never turns a corner."}],"constraints":["1 <= rows, cols <= 10","-100 <= value <= 100"],"approaches":[{"id":"boundaries","label":"Shrinking walls","complexity":{"time":"O(mn)","space":"O(1)"},"viz":{"matrix":"grid","out":"queue"},"layout":{},"source":["def boundaries(matrix):","    out = []","    top, bottom = 0, len(matrix) - 1","    left, right = 0, len(matrix[0]) - 1","    while top <= bottom and left <= right:","        for c in range(left, right + 1):","            out.append(matrix[top][c])","        top += 1","        for r in range(top, bottom + 1):","            out.append(matrix[r][right])","        right -= 1","        if top <= bottom:","            for c in range(right, left - 1, -1):","                out.append(matrix[bottom][c])","            bottom -= 1","        if left <= right:","            for r in range(bottom, top - 1, -1):","                out.append(matrix[r][left])","            left += 1","    return out"],"variants":[{"id":"typical","label":"3 x 3","note":null,"result":[1,2,3,6,9,8,7,4,5],"steps":[{"line":0,"note":null,"ops":[["set",["matrix"],[[1,2,3],[4,5,6],[7,8,9]]]]},{"line":1,"note":null,"ops":[["set",["out"],[]]]},{"line":2,"note":"Four walls closing inward. The spiral is just these four shrinking.","ops":[["set",["top"],0],["set",["bottom"],2]]},{"line":3,"note":null,"ops":[["set",["left"],0],["set",["right"],2]]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["c"],0]]},{"line":6,"note":"Across the top row, left to right.","ops":[["set",["out"],[1]]]},{"line":5,"note":null,"ops":[["set",["c"],1]]},{"line":6,"note":"Across the top row, left to right.","ops":[["set",["out"],[1,2]]]},{"line":5,"note":null,"ops":[["set",["c"],2]]},{"line":6,"note":"Across the top row, left to right.","ops":[["set",["out"],[1,2,3]]]},{"line":5,"note":null,"ops":[]},{"line":7,"note":"That row is spent, so the ceiling drops.","ops":[["set",["top"],1]]},{"line":8,"note":null,"ops":[["set",["r"],1]]},{"line":9,"note":"Down the right-hand column.","ops":[["set",["out"],[1,2,3,6]]]},{"line":8,"note":null,"ops":[["set",["r"],2]]},{"line":9,"note":"Down the right-hand column.","ops":[["set",["out"],[1,2,3,6,9]]]},{"line":8,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["right"],1]]},{"line":11,"note":"would otherwise be read a second time, backwards.","ops":[]},{"line":12,"note":null,"ops":[["set",["c"],1]]},{"line":13,"note":"Back along the bottom, right to left.","ops":[["set",["out"],[1,2,3,6,9,8]]]},{"line":12,"note":null,"ops":[["set",["c"],0]]},{"line":13,"note":"Back along the bottom, right to left.","ops":[["set",["out"],[1,2,3,6,9,8,7]]]},{"line":12,"note":null,"ops":[]},{"line":14,"note":null,"ops":[["set",["bottom"],1]]},{"line":15,"note":null,"ops":[]},{"line":16,"note":null,"ops":[["set",["r"],1]]},{"line":17,"note":"Up the left-hand column, closing the ring.","ops":[["set",["out"],[1,2,3,6,9,8,7,4]]]},{"line":16,"note":null,"ops":[]},{"line":18,"note":null,"ops":[["set",["left"],1]]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["c"],1]]},{"line":6,"note":"Across the top row, left to right.","ops":[["set",["out"],[1,2,3,6,9,8,7,4,5]]]},{"line":5,"note":null,"ops":[]},{"line":7,"note":"That row is spent, so the ceiling drops.","ops":[["set",["top"],2]]},{"line":8,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["right"],0]]},{"line":11,"note":"would otherwise be read a second time, backwards.","ops":[]},{"line":15,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":19,"note":null,"ops":[]}]},{"id":