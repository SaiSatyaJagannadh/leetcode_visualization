{"schemaVersion":1,"slug":"insert-interval","title":"Insert Interval","pattern":"Intervals","difficulty":"Medium","leetcode":57,"prompt":"Insert a new interval into a list that is already sorted and non-overlapping, merging anything it runs into. Return the result still sorted.","examples":[{"input":"intervals = [[1,3],[6,9]], newInterval = [2,5]","output":"[[1,5],[6,9]]"},{"input":"intervals = [[1,5]], newInterval = [6,8]","output":"[[1,5],[6,8]]"}],"constraints":["0 <= len(intervals) <= 10^4","intervals is sorted by start"],"approaches":[{"id":"three-phases","label":"Before, overlapping, after","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"intervals":"intervals","out":"intervals","merged":"interval","new":"interval"},"layout":{},"source":["def three_phases(intervals, new):","    out = []","    i = 0","    n = len(intervals)","    while i < n and intervals[i][1] < new[0]:","        out.append(intervals[i])","        i += 1","    merged = [new[0], new[1]]","    while i < n and intervals[i][0] <= merged[1]:","        merged[0] = min(merged[0], intervals[i][0])","        merged[1] = max(merged[1], intervals[i][1])","        i += 1","    out.append(merged)","    while i < n:","        out.append(intervals[i])","        i += 1","    return out"],"variants":[{"id":"typical","label":"Merges one","note":null,"result":[[1,5],[6,9]],"steps":[{"line":0,"ops":[["set",["intervals"],[[1,3],[6,9]]],["set",["new"],[2,5]]],"note":null},{"line":1,"ops":[["set",["out"],[]]],"note":null},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[["set",["n"],2]],"note":null},{"line":4,"ops":[],"note":"Phase one: everything ending before the new interval starts is untouched."},{"line":7,"ops":[["set",["merged"],[2,5]]],"note":"input being sorted is what makes these form one contiguous run."},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["merged",0],1]],"note":null},{"line":10,"ops":[],"note":null},{"line":11,"ops":[["set",["i"],1]],"note":null},{"line":8,"ops":[],"note":null},{"line":12,"ops":[["set",["out"],[[1,5]]]],"note":null},{"line":13,"ops":[],"note":"Phase three: the rest start after the merged block, so they follow as-is."},{"line":14,"ops":[["set",["out"],[[1,5],[6,9]]]],"note":null},{"line":15,"ops":[["set",["i"],2]],"note":null},{"line":13,"ops":[],"note":"Phase three: the rest start after the merged block, so they follow as-is."},{"line":16,"ops":[],"note":null}]},{"id":"edge","label":"No overlap","note":null,"result":[[1,5],[6,8]],"steps":[{"line":0,"ops":[["set",["intervals"],[[1,5]]],["set",["new"],[6,8]]],"note":null},{"line":1,"ops":[["set",["out"],[]]],"note":null},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[["set",["n"],1]],"note":null},{"line":4,"ops":[],"note":"Phase one: everything ending before the new interval starts is untouched."},{"line":5,"ops":[["set",["out"],[[1,5]]]],"note":null},{"line":6,"ops":[["set",["i"],1]],"note":null},{"line":4,"ops":[],"note":"Phase one: everything ending before the new interval starts is untouched."},{"line":7,"ops":[["set",["merged"],[6,8]]],"note":"input being sorted is what makes these form one contiguous run."},{"line":8,"ops":[],"note":null},{"line":12,"ops":[["set",["out"],[[1,5],[6,8]]]],"note":null},{"line":13,"ops":[],"note":"Phase three: the rest start after the merged block, so they follow as-is."},{"line":16,"ops":[],"note":null}]},{"id":"worst-case","label":"Swallows several","note":null,"result":[[1,2],[3,10]],"steps":[{"line":0,"ops":[["set",["intervals"],[[1,2],[3,5],[6,7],[8,10]]],["set",["new"],[4,9]]],"note":null},{"line":1,"ops":[["set",["out"],[]]],"note":null},{"line":2,"ops":[["set",["i"],0]],"note":null},{"line":3,"ops":[["set",["n"],4]],"note":null},{"line":4,"ops":[],"note":"Phase one: everything ending before the new interval starts is untouched."},{"line":5,"ops":[["set",["out"],[[1,2]]]],"note":null},{"line":6,"ops":[["set",["i"],1]],"note":null},{"line":4,"ops":[],"note":"Phase one: everything ending before the new interval starts is untouched."},{"line":7,"ops":[["set",["merged"],[4,9]]],"note":"input being sorted is what makes these form one contiguous run."},{"line":8,"ops":[],"note":null},{"line":9,"ops":[["set",["merged",0],3]],"note":null},{"line":10,"ops":[],"note":null},{"line":11,"ops":[["set",["i"],2]],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[],"note":null},{"line":11,"ops":[["set",["i"],3]],"note":null},{"line":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["merged",1],10]],"note":null},{"line":11,"ops":[["set",["i"],4]],"note":null},{"line":8,"ops":[],"note":null},{"line":12,"ops":[["set",["out"],[[1,2],[3,10]]]],"note":null},{"line":13,"ops":[],"note":"Phase three: the rest start after the merged block, so they follow as-is."},{"line":16,"ops":[],"note":null}]}]}]}