{"schemaVersion":1,"slug":"insert-interval","title":"Insert Interval","pattern":"Intervals","difficulty":"Medium","leetcode":57,"prompt":"Insert a new interval into a list that is already sorted and non-overlapping, merging anything it runs into. Return the result still sorted.","examples":[{"input":"intervals = [[1,3],[6,9]], newInterval = [2,5]","output":"[[1,5],[6,9]]"},{"input":"intervals = [[1,5]], newInterval = [6,8]","output":"[[1,5],[6,8]]"}],"constraints":["0 <= len(intervals) <= 10^4","intervals is sorted by start"],"approaches":[{"id":"sort-merge","label":"Append, sort, merge","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","out":"intervals"},"layout":{},"source":["def append_and_merge(intervals, new):","    spans = [[s[0], s[1]] for s in intervals]","    spans.append([new[0], new[1]])","    spans = sorted(spans, key=lambda s: s[0])","    out = []","    for span in spans:","        if out and span[0] <= out[-1][1]:","            out[-1] = [out[-1][0], max(out[-1][1], span[1])]","        else:","            out.append([span[0], span[1]])","    return out"],"variants":[{"id":"typical","label":"Merges one","note":null,"result":[[1,5],[6,9]],"steps":[{"line":0,"ops":[["set",["intervals"],[[1,3],[6,9]]],["set",["new"],[2,5]]],"note":null},{"line":1,"ops":[["set",["s"],[1,3]]],"note":"is exactly the information the three-phase walk exploits."},{"line":1,"ops":[["set",["s",0],6],["set",["s",1],9]],"note":"is exactly the information the three-phase walk exploits."},{"line":1,"ops":[["del",["s"]],["set",["spans"],[[1,3],[6,9]]]],"note":"is exactly the information the three-phase walk exploits."},{"line":2,"ops":[["set",["spans"],[[1,3],[6,9],[2,5]]]],"note":null},{"line":3,"ops":[["set",["spans",1,0],2],["set",["spans",1,1],5],["set",["spans",2,0],6],["set",["spans",2,1],9]],"note":null},{"line":4,"ops":[["set",["out"],[]]],"note":null},{"line":5,"ops":[["set",["span"],[1,3]]],"note":null},{"line":6,"ops":[],"no