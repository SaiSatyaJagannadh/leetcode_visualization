{"schemaVersion":1,"slug":"house-robber","title":"House Robber","pattern":"1-D Dynamic Programming","difficulty":"Medium","leetcode":198,"prompt":"Each house holds some money, but robbing two adjacent houses trips the alarm. Return the most you can take.","examples":[{"input":"nums = [1,2,3,1]","output":"4","why":"Houses 0 and 2."},{"input":"nums = [2,7,9,3,1]","output":"12","why":"Houses 0, 2 and 4."}],"constraints":["1 <= len(nums) <= 100","0 <= nums[i] <= 400"],"approaches":[{"id":"table","label":"Full DP table","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"nums":"array","best":"array","i":"pointer:best"},"layout":{},"source":["def table(nums):","    best = [0] * (len(nums) + 1)","    best[1] = nums[0]","    for i in range(2, len(nums) + 1):","        rob = best[i - 2] + nums[i - 1]","        if rob > best[i - 1]:","            best[i] = rob","        else:","            best[i] = best[i - 1]","    return best[len(nums)]"],"variants":[{"id":"typical","label":"Typical","note":null,"result":12,"steps":[{"line":0,"ops":[["set",["nums"],[2,7,9,3,1]]],"note":null},{"line":1,"ops":[["set",["best"],[0,0,0,0,0,0]]],"note":"is this same table with everything older than two slots thrown away."},{"line":2,"ops":[["set",["best",1],2]],"note":null},{"line":3,"ops":[["set",["i"],2]],"note":null},{"line":4,"ops":[["set",["rob"],7]],"note":"the previous total. Whichever is larger."},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["best",2],7]],"note":null},{"line":3,"ops":[["set",["i"],3]],"note":null},{"line":4,"ops":[["set",["rob"],11]],"note":"the previous total. Whichever is larger."},{"line":5,"ops":[],"note":null},{"line":6,"ops":[["set",["best",3],11]],"note":null},{"line":3,"ops":[["set",["i"],4]],"note":null},{"line":4,"ops":[["set",["rob"],10]],"note":"the previous total. Whichever is larger."},{"line":5,"ops":[],"note":null},{"line":8,"ops":[["set",["best",4],11]],"note":null},{"line":3,"ops":[["set",["i"],5]],"note":null},{"line":4,"ops":[["set",["rob"