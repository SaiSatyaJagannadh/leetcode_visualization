{"schemaVersion":1,"slug":"plus-one","title":"Plus One","pattern":"Math & Geometry","difficulty":"Easy","leetcode":66,"prompt":"A number is stored as an array of digits, most significant first. Add one to it and return the digits.","examples":[{"input":"digits = [1,2,3]","output":"[1,2,4]"},{"input":"digits = [9,9]","output":"[1,0,0]","why":"The carry runs off the front and adds a digit."}],"constraints":["1 <= len(digits) <= 100","No leading zeros"],"approaches":[{"id":"locate","label":"Find the last non-nine","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"digits":"array","out":"array","at":"pointer:out","i":"pointer:out"},"layout":{},"source":["def find_the_last_non_nine(digits):","    out = list(digits)","    at = -1","    for i in range(len(out)):","        if out[i] != 9:","            at = i","    if at == -1:","        return [1] + [0] * len(out)","    out[at] += 1","    for i in range(at + 1, len(out)):","        out[i] = 0","    return out"],"variants":[{"id":"typical","label":"No carry","note":null,"result":[1,2,4],"steps":[{"line":0,"ops":[["set",["digits"],[1,2,3]]],"note":null},{"line":1,"ops":[["set",["out"],[1,2,3]]],"note":"write the answer directly \u2014 no carry variable at all."},{"line":2,"ops":[["set",["at"],-1]],"note":null},{"line":3,"ops":[["set",["i"],0]],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["at"],0]],"note":"Remember the rightmost digit that can absorb the carry."},{"line":3,"ops":[["set",["i"],1]],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["at"],1]],"note":"Remember the rightmost digit that can absorb the carry."},{"line":3,"ops":[["set",["i"],2]],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["at"],2]],"note":"Remember the rightmost digit that can absorb the carry."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[],"note":null},{"line":8,"ops":[["set",["out",2],4]],"note":null},{"line":9,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]},{"id"