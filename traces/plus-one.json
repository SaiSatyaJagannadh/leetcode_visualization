{"schemaVersion":1,"slug":"plus-one","title":"Plus One","pattern":"Math & Geometry","difficulty":"Easy","leetcode":66,"prompt":"A number is stored as an array of digits, most significant first. Add one to it and return the digits.","examples":[{"input":"digits = [1,2,3]","output":"[1,2,4]"},{"input":"digits = [9,9]","output":"[1,0,0]","why":"The carry runs off the front and adds a digit."}],"constraints":["1 <= len(digits) <= 100","No leading zeros"],"approaches":[{"id":"carry","label":"Carry from the right","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"digits":"array","out":"array","i":"pointer:out"},"layout":{},"source":["def carry_backwards(digits):","    out = list(digits)","    for i in range(len(out) - 1, -1, -1):","        if out[i] < 9:","            out[i] += 1","            return out","        out[i] = 0","    return [1] + out"],"variants":[{"id":"typical","label":"No carry","note":null,"result":[1,2,4],"steps":[{"line":0,"ops":[["set",["digits"],[1,2,3]]],"note":null},{"line":1,"ops":[["set",["out"],[1,2,3]]],"note":null},{"line":2,"ops":[["set",["i"],2]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["out",2],4]],"note":"No carry out of this digit, so nothing further left can change."},{"line":5,"ops":[],"note":null}]},{"id":"edge","label":"All nines","note":null,"result":[1,0,0],"steps":[{"line":0,"ops":[["set",["digits"],[9,9]]],"note":null},{"line":1,"ops":[["set",["out"],[9,9]]],"note":null},{"line":2,"ops":[["set",["i"],1]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["out",1],0]],"note":"A 9 becomes 0 and passes the carry along."},{"line":2,"ops":[["set",["i"],0]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["out",0],0]],"note":"A 9 becomes 0 and passes the carry along."},{"line":2,"ops":[],"note":"Work right to left, the way addition carries."},{"line":7,"ops":[],"note":"one place \u2014 the only case where the answer is longer than the input."}]},{"id":"worst-case","label":"Carry stops midway","note":null,"result":[2,0,0],"steps":[{"line":0,"ops":[["set",["digits"],[1,9,9]]],"note":null},{"line":1,"ops":[["set",["out"],[1,9,9]]],"note":null},{"line":2,"ops":[["set",["i"],2]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["out",2],0]],"note":"A 9 becomes 0 and passes the carry along."},{"line":2,"ops":[["set",["i"],1]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["out",1],0]],"note":"A 9 becomes 0 and passes the carry along."},{"line":2,"ops":[["set",["i"],0]],"note":"Work right to left, the way addition carries."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["out",0],2]],"note":"No carry out of this digit, so nothing further left can change."},{"line":5,"ops":[],"note":null}]}]}]}