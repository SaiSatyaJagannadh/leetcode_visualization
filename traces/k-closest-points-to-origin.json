{"schemaVersion":1,"slug":"k-closest-points-to-origin","title":"K Closest Points to Origin","pattern":"Heap / Priority Queue","difficulty":"Medium","leetcode":973,"prompt":"Return the k points nearest the origin, measured by straight-line distance. The answer may be in any order.","examples":[{"input":"points = [[1,3],[-2,2]], k = 1","output":"[[-2,2]]"},{"input":"points = [[3,3],[5,-1],[-2,4]], k = 2","output":"[[3,3],[-2,4]]"}],"constraints":["1 <= k <= len(points) <= 10^4"],"unordered":true,"approaches":[{"id":"sort","label":"Sort by distance","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"points":"array","ordered":"array"},"layout":{},"source":["def sort_by_distance(points, k):","    ordered = sorted(points, key=lambda p: p[0] * p[0] + p[1] * p[1])","    return ordered[:k]"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[[0,1],[-2,2]],"steps":[{"line":0,"note":null,"ops":[["set",["points"],[[1,3],[-2,2],[5,8],[0,1]]],["set",["k"],2]]},{"line":1,"note":"Comparing squared distances avoids square roots and orders identically.","ops":[["set",["ordered"],[[0,1],[-2,2],[1,3],[5,8]]]]},{"line":2,"note":null,"ops":[]}]},{"id":"edge","label":"k = all","note":null,"result":[[1,1],[2,2]],"steps":[{"line":0,"note":null,"ops":[["set",["points"],[[1,1],[2,2]]],["set",["k"],2]]},{"line":1,"note":"Comparing squared distances avoids square roots and orders identically.","ops":[["set",["ordered"],[[1,1],[2,2]]]]},{"line":2,"note":null,"ops":[]}]},{"id":"worst-case","label":"Nearest last","note":null,"result":[[1,0]],"steps":[{"line":0,"note":null,"ops":[["set",["points"],[[9,9],[8,8],[1,0]]],["set",["k"],1]]},{"line":1,"note":"Comparing squared distances avoids square roots and orders identically.","ops":[["set",["ordered"],[[1,0],[8,8],[9,9]]]]},{"line":2,"note":null,"ops":[]}]}]},{"id":"heap","label":"Max-heap of size k","complexity":{"time":"O(n log k)","space":"O(k)"},"viz":{"points":"array","heap":"array","out":"array"},"layout":{},"source":["