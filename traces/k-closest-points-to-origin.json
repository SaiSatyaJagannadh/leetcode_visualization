{"schemaVersion":1,"slug":"k-closest-points-to-origin","title":"K Closest Points to Origin","pattern":"Heap / Priority Queue","difficulty":"Medium","leetcode":973,"prompt":"Return the k points nearest the origin, measured by straight-line distance. The answer may be in any order.","examples":[{"input":"points = [[1,3],[-2,2]], k = 1","output":"[[-2,2]]"},{"input":"points = [[3,3],[5,-1],[-2,4]], k = 2","output":"[[3,3],[-2,4]]"}],"constraints":["1 <= k <= len(points) <= 10^4"],"unordered":true,"approaches":[{"id":"sort","label":"Sort by distance","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"points":"array","ordered":"array"},"layout":{},"source":["def sort_by_distance(points, k):","    ordered = sorted(points, key=lambda p: p[0] * p[0] + p[1] * p[1])","    return ordered[:k]"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[[0,1],[-2,2]],"steps":[{"line":0,"ops":[["set",["points"],[[1,3],[-2,2],[5,8],[0,1]]],["set",["k"],2]],"note":null},{"line":1,"ops":[["set",["ordered"],[[0,1],[-2,2],[1,3],[5,8]]]],"note":"Comparing squared distances avoids square roots and orders identically."},{"line":2,"ops":[],"note":null}]},{"id":"edge","label":"k = all","note":null,"result":[[1,1],[2,2]],"steps":[{"line":0,"ops":[["set",["points"],[[1,1],[2,2]]],["set",["k"],2]],"note":null},{"line":1,"ops":[["set",["ordered"],[[1,1],[2,2]]]],"note":"Comparing squared distances avoids square roots and orders identically."},{"line":2,"ops":[],"note":null}]},{"id":"worst-case","label":"Nearest last","note":null,"result":[[1,0]],"steps":[{"line":0,"ops":[["set",["points"],[[9,9],[8,8],[1,0]]],["set",["k"],1]],"note":null},{"line":1,"ops":[["set",["ordered"],[[1,0],[8,8],[9,9]]]],"note":"Comparing squared distances avoids square roots and orders identically."},{"line":2,"ops":[],"note":null}]}]},{"id":"heap","label":"Max-heap of size k","complexity":{"time":"O(n log k)","space":"O(k)"},"viz":{"points":"array","heap":"array","out":"array"},"layout":{},"source":["def max_heap_of_k(points, k):","    heap = []","    for p in points:","        d = p[0] * p[0] + p[1] * p[1]","        heap.append([d, p[0], p[1]])","        i = len(heap) - 1","        while i > 0 and heap[(i - 1) // 2][0] < heap[i][0]:","            par = (i - 1) // 2","            heap[i], heap[par] = heap[par], heap[i]","            i = par","        if len(heap) > k:","            heap[0] = heap[-1]","            heap.pop()","            j = 0","            while True:","                big = j","                for c in (2 * j + 1, 2 * j + 2):","                    if c < len(heap) and heap[c][0] > heap[big][0]:","                        big = c","                if big == j:","                    break","                heap[j], heap[big] = heap[big], heap[j]","                j = big","    out = []","    for entry in heap:","        out.append([entry[1], entry[2]])","    return out"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[[-2,2],[0,1]],"steps":[{"line":0,"ops":[["set",["points"],[[1,3],[-2,2],[5,8],[0,1]]],["set",["k"],2]],"note":null},{"line":1,"ops":[["set",["heap"],[]]],"note":"of the current best \u2014 the one to evict when something better shows up."},{"line":2,"ops":[["set",["p"],[1,3]]],"note":null},{"line":3,"ops":[["set",["d"],10]],"note":null},{"line":4,"ops":[["set",["heap"],[[10,1,3]]]],"note":null},{"line":5,"ops":[["set",["i"],0]],"note":null},{"line":6,"ops":[],"note":null},{"line":10,"ops":[],"note":null},{"line":2,"ops":[["set",["p",0],-2],["set",["p",1],2]],"note":null},{"line":3,"ops":[["set",["d"],8]],"note":null},{"line":4,"ops":[["set",["heap"],[[10,1,3],[8,-2,2]]]],"note":null},{"line":5,"ops":[["set",["i"],1]],"note":null},{"line":6,"ops":[],"note":null},{"line":10,"ops":[],"note":null},{"line":2,"ops":[["set",["p",0],5],["set",["p",1],8]],"note":null},{"line":3,"ops":[["set",["d"],89]],"note":null},{"line":4,"ops":[["set",["heap"],[[10,1,3],[8,-2,2],[89,5,8]]]],"note":null},{"line":5,"ops":[["set",["i"],