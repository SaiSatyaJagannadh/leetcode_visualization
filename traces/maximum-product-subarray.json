{"schemaVersion":1,"slug":"maximum-product-subarray","title":"Maximum Product Subarray","pattern":"1-D Dynamic Programming","difficulty":"Medium","leetcode":152,"prompt":"Find the contiguous run of numbers with the largest product and return that product.","examples":[{"input":"nums = [2,3,-2,4]","output":"6","why":"The run [2,3]."},{"input":"nums = [-2,0,-1]","output":"0"}],"constraints":["1 <= len(nums) <= 2 * 10^4"],"approaches":[{"id":"both-ends","label":"Track the highest and lowest","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","i":"pointer:nums","candidates":"array"},"layout":{},"source":["def track_both_ends(nums):","    best = nums[0]","    high = nums[0]","    low = nums[0]","    for i in range(1, len(nums)):","        n = nums[i]","        candidates = [n, high * n, low * n]","        high = max(candidates)","        low = min(candidates)","        if high > best:","            best = high","    return best"],"variants":[{"id":"typical","label":"Typical","note":null,"result":6,"steps":[{"line":0,"ops":[["set",["nums"],[2,3,-2,4]]],"note":null},{"line":1,"ops":[["set",["best"],2]],"note":"negative number flips it into a large positive. So track both extremes."},{"line":2,"ops":[["set",["high"],2]],"note":null},{"line":3,"ops":[["set",["low"],2]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["n"],3]],"note":null},{"line":6,"ops":[["set",["candidates"],[3,6,6]]],"note":"both have to be recomputed from the old pair at once."},{"line":7,"ops":[["set",["high"],6]],"note":null},{"line":8,"ops":[["set",["low"],3]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["best"],6]],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[["set",["n"],-2]],"note":null},{"line":6,"ops":[["set",["candidates",0],-2],["set",["candidates",1],-12],["set",["candidates",2],-6]],"note":"both have to be recomputed from the old pair at once."},{"line":7,"ops":[["set",["high"],-2]],"note":null},{"line":8,"ops":[["set",["low"],-12]],"note":null},{"line":9,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],3]],"note":null},{"line":5,"ops":[["set",["n"],4]],"note":null},{"line":6,"ops":[["set",["candidates",0],4],["set",["candidates",1],-8],["set",["candidates",2],-48]],"note":"both have to be recomputed from the old pair at once."},{"line":7,"ops":[["set",["high"],4]],"note":null},{"line":8,"ops":[["set",["low"],-48]],"note":null},{"line":9,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]},{"id":"edge","label":"Zero resets","note":null,"result":0,"steps":[{"line":0,"ops":[["set",["nums"],[-2,0,-1]]],"note":null},{"line":1,"ops":[["set",["best"],-2]],"note":"negative number flips it into a large positive. So track both extremes."},{"line":2,"ops":[["set",["high"],-2]],"note":null},{"line":3,"ops":[["set",["low"],-2]],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["n"],0]],"note":null},{"line":6,"ops":[["set",["candidates"],[0,0,0]]],"note":"both have to be recomputed from the old pair at once."},{"line":7,"ops":[["set",["high"],0]],"note":null},{"line":8,"ops":[["set",["low"],0]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["best"],0]],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[["set",["n"],-1]],"note":null},{"line":6,"ops":[["set",["candidates",0],-1]],"note":"both have to be recomputed from the old pair at once."},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["low"],-1]],"note":null},{"line":9,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":11,"ops":[],"note":null}]},{"id":"worst-case","label":"Two negatives","note":null,"result":24,"steps":[{"line":0,"ops":[["set",["nums"],[-2,3,-4]]],"note":null},{"line":1,"ops":[["set",["best"],-2]],"note":"negative number flips it into a large positive. So track both extremes."},{"line":2,"ops":[["set",["high"],-2]],"note":null},{"line":3,"ops":[["s