{"schemaVersion":1,"slug":"powx-n","title":"Pow(x, n)","pattern":"Math & Geometry","difficulty":"Medium","leetcode":50,"prompt":"Raise x to the power n, where n may be negative. Do it in logarithmic time rather than by repeated multiplication.","examples":[{"input":"x = 2.0, n = 10","output":"1024.0"},{"input":"x = 2.0, n = -2","output":"0.25"}],"constraints":["-100 < x < 100","n fits in a 32-bit integer"],"approaches":[{"id":"fast","label":"Square and halve","complexity":{"time":"O(log n)","space":"O(1)"},"viz":{},"layout":{},"source":["def fast_power(x, n):","    base = x","    power = n","    if power < 0:","        base = 1 / base","        power = -power","    result = 1.0","    while power > 0:","        if power % 2 == 1:","            result = result * base","        base = base * base","        power = power // 2","    return result"],"variants":[{"id":"typical","label":"Positive power","note":null,"result":1024.0,"steps":[{"line":0,"ops":[["set",["x"],2.0],["set",["n"],10]],"note":null},{"line":1,"ops":[["set",["base"],2.0]],"note":"A negative exponent is the reciprocal of the positive one."},{"line":2,"ops":[["set",["power"],10]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["result"],1.0]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":10,"ops":[["set",["base"],4.0]],"note":null},{"line":11,"ops":[["set",["power"],5]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":9,"ops":[["set",["result"],4.0]],"note":null},{"line":10,"ops":[["set",["base"],16.0]],"note":null},{"line":11,"ops":[["set",["power"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":10,"ops":[["set",["base"],256.0]],"note":null},{"line":11,"ops":[["set",["power"],1]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":9,"ops":[["set",["result"],1024.0]],"note":null},{"line":10,"ops":[["set",["base"],65536.0]],"note":null},{"line":11,"ops":[["set",["power"],0]],"note":null},{"line":7,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]},{"id":"edge","label":"Negative power","note":null,"result":0.25,"steps":[{"line":0,"ops":[["set",["x"],2.0],["set",["n"],-2]],"note":null},{"line":1,"ops":[["set",["base"],2.0]],"note":"A negative exponent is the reciprocal of the positive one."},{"line":2,"ops":[["set",["power"],-2]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["base"],0.5]],"note":null},{"line":5,"ops":[["set",["power"],2]],"note":null},{"line":6,"ops":[["set",["result"],1.0]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":10,"ops":[["set",["base"],0.25]],"note":null},{"line":11,"ops":[["set",["power"],1]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":9,"ops":[["set",["result"],0.25]],"note":null},{"line":10,"ops":[["set",["base"],0.0625]],"note":null},{"line":11,"ops":[["set",["power"],0]],"note":null},{"line":7,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]},{"id":"worst-case","label":"Zero power","note":null,"result":1.0,"steps":[{"line":0,"ops":[["set",["x"],3.0],["set",["n"],0]],"note":null},{"line":1,"ops":[["set",["base"],3.0]],"note":"A negative exponent is the reciprocal of the positive one."},{"line":2,"ops":[["set",["power"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["result"],1.0]],"note":null},{"line":7,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]}]}]}