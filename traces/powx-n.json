{"schemaVersion":1,"slug":"powx-n","title":"Pow(x, n)","pattern":"Math & Geometry","difficulty":"Medium","leetcode":50,"prompt":"Raise x to the power n, where n may be negative. Do it in logarithmic time rather than by repeated multiplication.","examples":[{"input":"x = 2.0, n = 10","output":"1024.0"},{"input":"x = 2.0, n = -2","output":"0.25"}],"constraints":["-100 < x < 100","n fits in a 32-bit integer"],"approaches":[{"id":"recursive","label":"Halve recursively","complexity":{"time":"O(log n)","space":"O(log n)"},"viz":{"$calls":"recursion"},"layout":{},"source":["def halve_recursively(x, n):","    base = x","    power = n","    if power < 0:","        base = 1 / base","        power = -power","    return _pow(base, power)","","def _pow(base, power):","    if power == 0:","        return 1.0","    half = _pow(base, power // 2)","    if power % 2 == 0:","        return half * half","    return half * half * base"],"variants":[{"id":"typical","label":"Positive power","note":null,"result":1024.0,"steps":[{"line":0,"ops":[["set",["x"],2.0],["set",["n"],10]],"note":null},{"line":1,"ops":[["set",["base"],2.0]],"note":"saving directly: one subproblem, not two, so the depth is log n."},{"line":2,"ops":[["set",["power"],10]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["del",["x"]],["del",["n"]],["set",["$calls"],{"0":{"parent":null,"depth":0,"fn":"halve_recursively","args":{"x":2.0,"n":10},"ret":null,"status":"active","enteredAt":0,"at":[0.0,0.0]},"1":{"parent":"0","depth":1,"fn":"_pow","args":{"base":2.0,"power":10},"ret":null,"status":"active","enteredAt":4,"at":[1.0,1.0]}}]],"note":null},{"line":9,"ops":[],"note":null},{"line":11,"ops":[["set",["power"],5],["set",["$calls","2"],{"parent":"1","depth":2,"fn":"_pow","args":{"base":2.0,"power":5},"ret":null,"status":"active","enteredAt":6,"at":[2.0,2.0]}]],"note":null},{"line":9,"ops":[],"note":null},{"line":11,"ops":[["set",["power"],2],["set",["$calls","3"],{"parent":"2","depth":3,"fn":"_pow","args":{"