,"ops":[],"note":"Odd: squaring loses one factor of the base, so put it back."},{"line":14,"ops":[["set",["power"],2],["set",["half"],0.5],["set",["$calls","2","ret"],0.5],["set",["$calls","2","status"],"returned"]],"note":"Odd: squaring loses one factor of the base, so put it back."},{"line":12,"ops":[],"note":null},{"line":13,"ops":[],"note":"Even: the two halves are identical, so square the one we computed."},{"line":13,"ops":[["del",["half"]],["set",["x"],2.0],["set",["n"],-2],["set",["$calls","1","ret"],0.25],["set",["$calls","1","status"],"returned"]],"note":"Even: the two halves are identical, so square the one we computed."},{"line":6,"ops":[["set",["$calls","0","ret"],0.25],["set",["$calls","0","status"],"returned"]],"note":null}]},{"id":"worst-case","label":"Zero power","note":null,"result":1.0,"steps":[{"line":0,"ops":[["set",["x"],3.0],["set",["n"],0]],"note":null},{"line":1,"ops":[["set",["base"],3.0]],"note":"saving directly: one subproblem, not two, so the depth is log n."},{"line":2,"ops":[["set",["power"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["del",["x"]],["del",["n"]],["set",["$calls"],{"0":{"parent":null,"depth":0,"fn":"halve_recursively","args":{"x":3.0,"n":0},"ret":null,"status":"active","enteredAt":0,"at":[0.0,0.0]},"1":{"parent":"0","depth":1,"fn":"_pow","args":{"base":3.0,"power":0},"ret":null,"status":"active","enteredAt":4,"at":[1.0,1.0]}}]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[],"note":"Anything to the zero is one, which anchors the whole recursion."},{"line":10,"ops":[["set",["x"],3.0],["set",["n"],0],["set",["$calls","1","ret"],1.0],["set",["$calls","1","status"],"returned"]],"note":"Anything to the zero is one, which anchors the whole recursion."},{"line":6,"ops":[["set",["$calls","0","ret"],1.0],["set",["$calls","0","status"],"returned"]],"note":null}]}]},{"id":"fast","label":"Square and halve","complexity":{"time":"O(log n)","space":"O(1)"},"viz":{},"layout":{},"source":["def fast_power(x, n):","    base = x","    power = n","    if power < 0:","        base = 1 / base","        power = -power","    result = 1.0","    while power > 0:","        if power % 2 == 1:","            result = result * base","        base = base * base","        power = power // 2","    return result"],"variants":[{"id":"typical","label":"Positive power","note":null,"result":1024.0,"steps":[{"line":0,"ops":[["set",["x"],2.0],["set",["n"],10]],"note":null},{"line":1,"ops":[["set",["base"],2.0]],"note":"A negative exponent is the reciprocal of the positive one."},{"line":2,"ops":[["set",["power"],10]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["result"],1.0]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":10,"ops":[["set",["base"],4.0]],"note":null},{"line":11,"ops":[["set",["power"],5]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":9,"ops":[["set",["result"],4.0]],"note":null},{"line":10,"ops":[["set",["base"],16.0]],"note":null},{"line":11,"ops":[["set",["power"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":10,"ops":[["set",["base"],256.0]],"note":null},{"line":11,"ops":[["set",["power"],1]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[],"note":"logarithmic. The odd bit is what decides whether to fold in the base."},{"line":9,"ops":[["set",["result"],1024.0]],"note":null},{"line":10,"ops":[["set",["base"],65536.0]],"note":null},{"line":11,"ops":[["set",["power"],0]],"note":null},{"line":7,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]},{"id":"edge","label":"Negative power","note":null,"result":0.25,"steps":[{"line":0,"ops":[["set",["x"],2.0],["set",["n"],-2]],"note":null},{"line":1,"ops":[["set",["