{"schemaVersion":1,"slug":"interleaving-string","title":"Interleaving String","pattern":"2-D Dynamic Programming","difficulty":"Medium","leetcode":97,"prompt":"Decide whether the third string can be formed by shuffling the first two together while each keeps its own order.","examples":[{"input":"s1 = \"aab\", s2 = \"axy\", s3 = \"aaxaby\"","output":"true"},{"input":"s1 = \"ab\", s2 = \"cd\", s3 = \"abcde\"","output":"false","why":"Lengths don't add up."}],"constraints":["0 <= len(s1), len(s2) <= 100"],"approaches":[{"id":"table","label":"Fill the grid","complexity":{"time":"O(mn)","space":"O(mn)"},"viz":{"dp":"grid","i":"row:dp","j":"col:dp"},"layout":{},"source":["def table(a, b, c):","    if len(a) + len(b) != len(c):","        return False","    dp = [[False] * (len(b) + 1) for _ in range(len(a) + 1)]","    dp[0][0] = True","    for i in range(len(a) + 1):","        for j in range(len(b) + 1):","            if i > 0 and dp[i - 1][j] and a[i - 1] == c[i + j - 1]:","                dp[i][j] = True","            if j > 0 and dp[i][j - 1] and b[j - 1] == c[i + j - 1]:","                dp[i][j] = True","    return dp[len(a)][len(b)]"],"variants":[{"id":"typical","label":"Interleaves","note":null,"result":true,"steps":[{"line":0,"ops":[["set",["a"],"aab"],["set",["b"],"axy"],["set",["c"],"aaxaby"]],"note":null},{"line":1,"ops":[],"note":null},{"line":3,"ops":[],"note":"enough rather than three nested loops."},{"line":3,"ops":[],"note":"enough rather than three nested loops."},{"line":3,"ops":[],"note":"enough rather than three nested loops."},{"line":3,"ops":[],"note":"enough rather than three nested loops."},{"line":3,"ops":[["set",["dp"],[[false,false,false,false],[false,false,false,false],[false,false,false,false],[false,false,false,false]]]],"note":"enough rather than three nested loops."},{"line":4,"ops":[["set",["dp",0,0],true]],"note":null},{"line":5,"ops":[["set",["i"],0]],"note":null},{"line":6,"ops":[["set",["j"],0]],"note":null},{"line":7,"ops":[],"note":nu