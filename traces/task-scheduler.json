{"schemaVersion":1,"slug":"task-scheduler","title":"Task Scheduler","pattern":"Heap / Priority Queue","difficulty":"Medium","leetcode":621,"prompt":"Identical tasks must be separated by at least n intervals of cooldown. Each task takes one interval. Return the fewest intervals needed to run them all, counting idle time.","examples":[{"input":"tasks = [\"A\",\"A\",\"A\",\"B\",\"B\",\"B\"], n = 2","output":"8","why":"A B idle A B idle A B."},{"input":"tasks = [\"A\",\"A\",\"A\",\"B\",\"B\",\"B\"], n = 0","output":"6","why":"No cooldown, so no idling."}],"constraints":["1 <= len(tasks) <= 10^4","0 <= n <= 100"],"approaches":[{"id":"frame","label":"Count from the busiest task","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"tasks":"array","counts":"map"},"layout":{},"source":["def from_the_busiest(tasks, n):","    counts = {}","    for t in tasks:","        counts[t] = counts.get(t, 0) + 1","    busiest = 0","    for t in counts:","        busiest = max(busiest, counts[t])","    tied = 0","    for t in counts:","        if counts[t] == busiest:","            tied += 1","    frame = (busiest - 1) * (n + 1) + tied","    return max(frame, len(tasks))"],"variants":[{"id":"typical","label":"With cooldown","note":null,"result":8,"steps":[{"line":0,"ops":[["set",["tasks"],["A","A","A","B","B","B"]],["set",["n"],2]],"note":null},{"line":1,"ops":[["set",["counts"],{}]],"note":null},{"line":2,"ops":[["set",["t"],"A"]],"note":null},{"line":3,"ops":[["set",["counts","A"],1]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["counts","A"],2]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["counts","A"],3]],"note":null},{"line":2,"ops":[["set",["t"],"B"]],"note":null},{"line":3,"ops":[["set",["counts","B"],1]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["counts","B"],2]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["counts","B"],3]],"note":null},{"line":2,"ops":[],"note":null},{"line":4,"ops":[["set",["busiest"],0]],"note":"n + 1 slots each, then one final run."},{"line":5,"ops":[["set",["t"],"A"]],"note":null},{"line":6,"ops":[["set",["busiest"],3]],"note":null},{"line":5,"ops":[["set",["t"],"B"]],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":7,"ops":[["set",["tied"],0]],"note":"Several tasks tied at that frequency each add one slot to the last block."},{"line":8,"ops":[["set",["t"],"A"]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["tied"],1]],"note":null},{"line":8,"ops":[["set",["t"],"B"]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["tied"],2]],"note":null},{"line":8,"ops":[],"note":null},{"line":11,"ops":[["set",["frame"],8]],"note":null},{"line":12,"ops":[],"note":"and the answer is simply the number of tasks."}]},{"id":"edge","label":"No cooldown","note":null,"result":3,"steps":[{"line":0,"ops":[["set",["tasks"],["A","A","B"]],["set",["n"],0]],"note":null},{"line":1,"ops":[["set",["counts"],{}]],"note":null},{"line":2,"ops":[["set",["t"],"A"]],"note":null},{"line":3,"ops":[["set",["counts","A"],1]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[["set",["counts","A"],2]],"note":null},{"line":2,"ops":[["set",["t"],"B"]],"note":null},{"line":3,"ops":[["set",["counts","B"],1]],"note":null},{"line":2,"ops":[],"note":null},{"line":4,"ops":[["set",["busiest"],0]],"note":"n + 1 slots each, then one final run."},{"line":5,"ops":[["set",["t"],"A"]],"note":null},{"line":6,"ops":[["set",["busiest"],2]],"note":null},{"line":5,"ops":[["set",["t"],"B"]],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":7,"ops":[["set",["tied"],0]],"note":"Several tasks tied at that frequency each add one slot to the last block."},{"line":8,"ops":[["set",["t"],"A"]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["tied"],1]],"note":null},{"line":8,"ops":[["set",["t"],"B"]],"note":null},{"line":9,"ops":[],"note":