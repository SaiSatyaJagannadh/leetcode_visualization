{"schemaVersion":1,"slug":"task-scheduler","title":"Task Scheduler","pattern":"Heap / Priority Queue","difficulty":"Medium","leetcode":621,"prompt":"Identical tasks must be separated by at least n intervals of cooldown. Each task takes one interval. Return the fewest intervals needed to run them all, counting idle time.","examples":[{"input":"tasks = [\"A\",\"A\",\"A\",\"B\",\"B\",\"B\"], n = 2","output":"8","why":"A B idle A B idle A B."},{"input":"tasks = [\"A\",\"A\",\"A\",\"B\",\"B\",\"B\"], n = 0","output":"6","why":"No cooldown, so no idling."}],"constraints":["1 <= len(tasks) <= 10^4","0 <= n <= 100"],"approaches":[{"id":"frame","label":"Count from the busiest task","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"tasks":"array","counts":"map"},"layout":{},"source":["def from_the_busiest(tasks, n):","    counts = {}","    for t in tasks:","        counts[t] = counts.get(t, 0) + 1","    busiest = 0","    for t in counts:","        busiest = max(busiest, counts[t])","    tied = 0","    for t in counts:","        if counts[t] == busiest:","            tied += 1","    frame = (busiest - 1) * (n + 1) + tied","    return max(frame, len(tasks))"],"variants":[{"id":"typical","label":"With cooldown","note":null,"result":8,"steps":[{"line":0,"note":null,"ops":[["set",["tasks"],["A","A","A","B","B","B"]],["set",["n"],2]]},{"line":1,"note":null,"ops":[["set",["counts"],{}]]},{"line":2,"note":null,"ops":[["set",["t"],"A"]]},{"line":3,"note":null,"ops":[["set",["counts","A"],1]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[["set",["counts","A"],2]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[["set",["counts","A"],3]]},{"line":2,"note":null,"ops":[["set",["t"],"B"]]},{"line":3,"note":null,"ops":[["set",["counts","B"],1]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[["set",["counts","B"],2]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[["set",["counts","B"],3]]},{"line":2,"note":null,"ops":[]},{"line":4,