{"schemaVersion":1,"slug":"find-median-from-data-stream","title":"Find Median From Data Stream","pattern":"Heap / Priority Queue","difficulty":"Hard","leetcode":295,"prompt":"Numbers arrive one at a time. After each one, report the median of everything seen so far.","examples":[{"input":"add 1, add 2, findMedian()","output":"1.5"},{"input":"add 3, findMedian()","output":"2.0"}],"constraints":["Up to 5 * 10^4 calls","findMedian must be O(1)"],"approaches":[{"id":"two-heaps","label":"Two heaps facing each other","complexity":{"time":"O(log n) per add","space":"O(n)"},"viz":{"low":"heap","high":"heap","out":"queue","stream":"array"},"layout":{},"source":["def two_heaps(stream):","    low = []","    high = []","    out = []","    for v in stream:","        _push(low, -v)","        _push(high, -_pop(low))","        if len(high) > len(low):","            _push(low, -_pop(high))","        if len(low) > len(high):","            out.append(-low[0] * 1.0)","        else:","            out.append((-low[0] + high[0]) / 2.0)","    return out"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[1.0,1.5,2.0,2.5,3.0],"steps":[{"line":0,"note":null,"ops":[["set",["stream"],[1,2,3,4,5]]]},{"line":1,"note":"sitting on one or both of the two roots, so reading it is free.","ops":[["set",["low"],[]]]},{"line":2,"note":null,"ops":[["set",["high"],[]]]},{"line":3,"note":null,"ops":[["set",["out"],[]]]},{"line":4,"note":null,"ops":[["set",["v"],1]]},{"line":5,"note":"That single funnel guarantees every value lands on the correct side.","ops":[["set",["low"],[-1]]]},{"line":6,"note":null,"ops":[["set",["low"],[]],["set",["high"],[1]]]},{"line":7,"note":null,"ops":[]},{"line":8,"note":"median is always low's root.","ops":[["set",["low"],[-1]],["set",["high"],[]]]},{"line":9,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["out"],[1.0]]]},{"line":4,"note":null,"ops":[["set",["v"],2]]},{"line":5,"note":"That single funnel guarantees every value lands on the correct s