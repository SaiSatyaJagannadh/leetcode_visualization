{"schemaVersion":1,"slug":"clone-graph","title":"Clone Graph","pattern":"Graphs","difficulty":"Medium","leetcode":133,"prompt":"Make a deep copy of a connected undirected graph: every node duplicated, every edge rebuilt between the duplicates rather than the originals.","examples":[{"input":"adjList = [[2,4],[1,3],[2,4],[1,3]]","output":"[[2,4],[1,3],[2,4],[1,3]]"},{"input":"adjList = [[]]","output":"[[]]","why":"A single node with no neighbours."}],"constraints":["0 <= number of nodes <= 100","The graph is connected"],"approaches":[{"id":"dfs","label":"DFS with a clone map","complexity":{"time":"O(V + E)","space":"O(V)"},"viz":{"adj":"graph","made":"map","$calls":"recursion"},"layout":{"adj":{"1":[0.0,-1.0],"2":[1.0,0.0],"3":[0.0,1.0],"4":[-1.0,0.0]}},"source":["def dfs_clone(adj, start):","    made = {}","    _copy(adj, start, made)","    out = {}","    for key in made:","        out[key] = made[key]","    return out"],"variants":[{"id":"typical","label":"Square","note":null,"result":{"1":[2,4],"2":[1,3],"3":[2,4],"4":[1,3]},"steps":[{"line":0,"note":null,"ops":[["set",["adj"],{"1":[2,4],"2":[1,3],"3":[2,4],"4":[1,3]}],["set",["start"],1]]},{"line":1,"note":"visited-set. Without that, a cycle would make this recurse forever.","ops":[["set",["made"],{}]]},{"line":2,"note":null,"ops":[["set",["made","1"],[2,4]],["set",["made","2"],[1,3]],["set",["made","3"],[2,4]],["set",["made","4"],[1,3]]]},{"line":3,"note":"Rebuild the adjacency of the copy so the result is comparable.","ops":[["set",["out"],{}]]},{"line":4,"note":null,"ops":[["set",["key"],"1"]]},{"line":5,"note":null,"ops":[["set",["out","1"],[2,4]]]},{"line":4,"note":null,"ops":[["set",["key"],"2"]]},{"line":5,"note":null,"ops":[["set",["out","2"],[1,3]]]},{"line":4,"note":null,"ops":[["set",["key"],"3"]]},{"line":5,"note":null,"ops":[["set",["out","3"],[2,4]]]},{"line":4,"note":null,"ops":[["set",["key"],"4"]]},{"line":5,"note":null,"ops":[["set",["out","4"],[1,3]]]},{"line":4,"note":null,"ops":[]},{"line":6,"note":null,"ops":[]}]},{"id":"edge","label":"Single node","note":null,"result":{"1":[]},"steps":[{"line":0,"note":null,"ops":[["set",["adj"],{"1":[]}],["set",["start"],1]]},{"line":1,"note":"visited-set. Without that, a cycle would make this recurse forever.","ops":[["set",["made"],{}]]},{"line":2,"note":null,"ops":[["set",["made","1"],[]]]},{"line":3,"note":"Rebuild the adjacency of the copy so the result is comparable.","ops":[["set",["out"],{}]]},{"line":4,"note":null,"ops":[["set",["key"],"1"]]},{"line":5,"note":null,"ops":[["set",["out","1"],[]]]},{"line":4,"note":null,"ops":[]},{"line":6,"note":null,"ops":[]}]},{"id":"worst-case","label":"Fully connected","note":null,"result":{"1":[2,3],"2":[1,3],"3":[1,2]},"steps":[{"line":0,"note":null,"ops":[["set",["adj"],{"1":[2,3],"2":[1,3],"3":[1,2]}],["set",["start"],1]]},{"line":1,"note":"visited-set. Without that, a cycle would make this recurse forever.","ops":[["set",["made"],{}]]},{"line":2,"note":null,"ops":[["set",["made","1"],[2,3]],["set",["made","2"],[1,3]],["set",["made","3"],[1,2]]]},{"line":3,"note":"Rebuild the adjacency of the copy so the result is comparable.","ops":[["set",["out"],{}]]},{"line":4,"note":null,"ops":[["set",["key"],"1"]]},{"line":5,"note":null,"ops":[["set",["out","1"],[2,3]]]},{"line":4,"note":null,"ops":[["set",["key"],"2"]]},{"line":5,"note":null,"ops":[["set",["out","2"],[1,3]]]},{"line":4,"note":null,"ops":[["set",["key"],"3"]]},{"line":5,"note":null,"ops":[["set",["out","3"],[1,2]]]},{"line":4,"note":null,"ops":[]},{"line":6,"note":null,"ops":[]}]}]}]}