{"schemaVersion":1,"slug":"median-of-two-sorted-arrays","title":"Median of Two Sorted Arrays","pattern":"Binary Search","difficulty":"Hard","leetcode":4,"prompt":"Two sorted arrays are given. Find the median of the combined sequence without actually merging them, in logarithmic time.","examples":[{"input":"nums1 = [1,3], nums2 = [2]","output":"2.0"},{"input":"nums1 = [1,2], nums2 = [3,4]","output":"2.5","why":"The middle two are 2 and 3."}],"constraints":["0 <= len(nums1), len(nums2) <= 1000","Must run in O(log(m+n))"],"approaches":[{"id":"merge","label":"Merge then pick","complexity":{"time":"O(m + n)","space":"O(m + n)"},"viz":{"a":"array","b":"array","merged":"array","i":"pointer:a","j":"pointer:b"},"layout":{},"source":["def merge_then_pick(a, b):","    merged = []","    i = j = 0","    while i < len(a) or j < len(b):","        if j >= len(b) or (i < len(a) and a[i] <= b[j]):","            merged.append(a[i])","            i += 1","        else:","            merged.append(b[j])","            j += 1","    mid = len(merged) // 2","    if len(merged) % 2 == 1:","        return merged[mid] * 1.0","    return (merged[mid - 1] + merged[mid]) / 2.0"],"variants":[{"id":"typical","label":"Odd total","note":null,"result":2.0,"steps":[{"line":0,"ops":[["set",["a"],[1,3]],["set",["b"],[2]]],"note":null},{"line":1,"ops":[["set",["merged"],[]]],"note":"Merging is easy to follow but touches every element."},{"line":2,"ops":[["set",["i"],0],["set",["j"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1]]],"note":null},{"line":6,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2]]],"note":null},{"line":9,"ops":[["set",["j"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1,2,3]]],"note":null},{"line":6,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":10,"ops":[["set",["mid"],1]],"note":null},{"line":11,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]},{"id":"edge","label":"Even total","note":null,"result":2.5,"steps":[{"line":0,"ops":[["set",["a"],[1,2]],["set",["b"],[3,4]]],"note":null},{"line":1,"ops":[["set",["merged"],[]]],"note":"Merging is easy to follow but touches every element."},{"line":2,"ops":[["set",["i"],0],["set",["j"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1]]],"note":null},{"line":6,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1,2]]],"note":null},{"line":6,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2,3]]],"note":null},{"line":9,"ops":[["set",["j"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2,3,4]]],"note":null},{"line":9,"ops":[["set",["j"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":10,"ops":[["set",["mid"],2]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[],"note":null}]},{"id":"worst-case","label":"No overlap","note":null,"result":5.0,"steps":[{"line":0,"ops":[["set",["a"],[1,2,3]],["set",["b"],[7,8,9]]],"note":null},{"line":1,"ops":[["set",["merged"],[]]],"note":"Merging is easy to follow but touches every element."},{"line":2,"ops":[["set",["i"],0],["set",["j"],0]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1]]],"note":null},{"line":6,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1,2]]],"note":null},{"line":6,"ops":[["set",["i"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":5,"ops":[["set",["merged"],[1,2,3]]],"note":null},{"line":6,"ops":[["set",["i"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2,3,7]]],"note":null},{"line":9,"ops":[["set",["j"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2,3,7,8]]],"note":null},{"line":9,"ops":[["set",["j"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":8,"ops":[["set",["merged"],[1,2,3,7,8,9]]],"note":null},{"line":9,"ops":[["set",["j"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":10,"ops":[["set",["mid"],3]],"note":null},{"line":11,"ops":[],"note":null},{"line":13,"ops":[],"note":null}]}]},{"id":"partition","label":"Binary search the cut","complexity":{"time":"O(log min(m,n))","space":"O(1)"},"viz":{"a":"array","b":"array","i":"pointer:a","j":"pointer:b"},"layout":{},"source":["def partition_search(a, b):","    if len(a) > len(b):","        a, b = b, a","    total = len(a) + len(b)","    half = (total + 1) // 2","    lo, hi = 0, len(a)","    while True:","        i = (lo + hi) // 2","        j = half - i","        left_a = a[i - 1] if i > 0 else -BIG","        right_a = a[i] if i < len(a) else BIG","        left_b = b[j - 1] if j > 0 else -BIG","        right_b = b[j] if j < len(b) else BIG","        if left_a <= right_b and left_b <= right_a:","            if total % 2 == 1:","                return max(left_a, left_b) * 1.0","            return (max(left_a, left_b) + min(right_a, right_b)) / 2.0","        if left_a > right_b:","            hi = i - 1","        else:","            lo = i + 1"],"variants":[{"id":"typical","label":"Odd total","note":null,"result":2.0,"steps":[{"line":0,"ops":[["set",["a"],[1,3]],["set",["b"],[2]]],"note":null},{"line":1,"ops":[],"note":"Always binary-search the shorter array so the index range stays small."},{"line":2,"ops":[["set",["a"],[2]],["set",["b"],[1,3]]],"note":null},{"line":