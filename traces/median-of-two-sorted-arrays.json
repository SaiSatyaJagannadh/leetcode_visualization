{"schemaVersion":1,"slug":"median-of-two-sorted-arrays","title":"Median of Two Sorted Arrays","pattern":"Binary Search","difficulty":"Hard","leetcode":4,"prompt":"Two sorted arrays are given. Find the median of the combined sequence without actually merging them, in logarithmic time.","examples":[{"input":"nums1 = [1,3], nums2 = [2]","output":"2.0"},{"input":"nums1 = [1,2], nums2 = [3,4]","output":"2.5","why":"The middle two are 2 and 3."}],"constraints":["0 <= len(nums1), len(nums2) <= 1000","Must run in O(log(m+n))"],"approaches":[{"id":"merge","label":"Merge then pick","complexity":{"time":"O(m + n)","space":"O(m + n)"},"viz":{"a":"array","b":"array","merged":"array","i":"pointer:a","j":"pointer:b"},"layout":{},"source":["def merge_then_pick(a, b):","    merged = []","    i = j = 0","    while i < len(a) or j < len(b):","        if j >= len(b) or (i < len(a) and a[i] <= b[j]):","            merged.append(a[i])","            i += 1","        else:","            merged.append(b[j])","            j += 1","    mid = len(merged) // 2","    if len(merged) % 2 == 1:","        return merged[mid] * 1.0","    return (merged[mid - 1] + merged[mid]) / 2.0"],"variants":[{"id":"typical","label":"Odd total","note":null,"result":2.0,"steps":[{"line":0,"note":null,"ops":[["set",["a"],[1,3]],["set",["b"],[2]]]},{"line":1,"note":"Merging is easy to follow but touches every element.","ops":[["set",["merged"],[]]]},{"line":2,"note":null,"ops":[["set",["i"],0],["set",["j"],0]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1]]]},{"line":6,"note":null,"ops":[["set",["i"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2]]]},{"line":9,"note":null,"ops":[["set",["j"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1,2,3]]]},{"line":6,"note":null,"ops":[["set",["i"],2]]},{"line":3,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["mid"],1]]},{"line":11,"note":null,"ops":[]},{"line":12,"note":null,"ops":[]}]},{"id":"edge","label":"Even total","note":null,"result":2.5,"steps":[{"line":0,"note":null,"ops":[["set",["a"],[1,2]],["set",["b"],[3,4]]]},{"line":1,"note":"Merging is easy to follow but touches every element.","ops":[["set",["merged"],[]]]},{"line":2,"note":null,"ops":[["set",["i"],0],["set",["j"],0]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1]]]},{"line":6,"note":null,"ops":[["set",["i"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1,2]]]},{"line":6,"note":null,"ops":[["set",["i"],2]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2,3]]]},{"line":9,"note":null,"ops":[["set",["j"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2,3,4]]]},{"line":9,"note":null,"ops":[["set",["j"],2]]},{"line":3,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["mid"],2]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[]}]},{"id":"worst-case","label":"No overlap","note":null,"result":5.0,"steps":[{"line":0,"note":null,"ops":[["set",["a"],[1,2,3]],["set",["b"],[7,8,9]]]},{"line":1,"note":"Merging is easy to follow but touches every element.","ops":[["set",["merged"],[]]]},{"line":2,"note":null,"ops":[["set",["i"],0],["set",["j"],0]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1]]]},{"line":6,"note":null,"ops":[["set",["i"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1,2]]]},{"line":6,"note":null,"ops":[["set",["i"],2]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["merged"],[1,2,3]]]},{"line":6,"note":null,"ops":[["set",["i"],3]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2,3,7]]]},{"line":9,"note":null,"ops":[["set",["j"],1]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2,3,7,8]]]},{"line":9,"note":null,"ops":[["set",["j"],2]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]},{"line":8,"note":null,"ops":[["set",["merged"],[1,2,3,7,8,9]]]},{"line":9,"note":null,"ops":[["set",["j"],3]]},{"line":3,"note":null,"ops":[]},{"line":10,"note":null,"ops":[["set",["mid"],3]]},{"line":11,"note":null,"ops":[]},{"line":13,"note":null,"ops":[]}]}]},{"id":"partition","label":"Binary search the cut","complexity":{"time":"O(log min(m,n))","space":"O(1)"},"viz":{"a":"array","b":"array","i":"pointer:a","j":"pointer:b"},"layout":{},"source":["def partition_search(a, b):","    if len(a) > len(b):","        a, b = b, a","    total = len(a) + len(b)","    half = (total + 1) // 2","    lo, hi = 0, len(a)","    while True:","        i = (lo + hi) // 2","        j = half - i","        left_a = a[i - 1] if i > 0 else -BIG","        right_a = a[i] if i < len(a) else BIG","        left_b = b[j - 1] if j > 0 else -BIG","        right_b = b[j] if j < len(b) else BIG","        if left_a <= right_b and left_b <= right_a:","            if total % 2 == 1:","                return max(left_a, left_b) * 1.0","            return (max(left_a, left_b) + min(right_a, right_b)) / 2.0","        if left_a > right_b:","            hi = i - 1","        else:","            lo = i + 1"],"variants":[{"id":"typical","label":"Odd total","note":null,"result":2.0,"steps":[{"line":0,"note":null,"ops":[["set",["a"],[1,3]],["set",["b"],[2]]]},{"line":1,"note":"Always binary-search the shorter array so the index range stays small.","ops":[]},{"line":2,"note":null,"ops":[["set",["a"],[2]],["set",["b"],[1,3]]]},{"line":