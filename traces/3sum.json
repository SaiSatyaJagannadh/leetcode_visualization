,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":8,"ops":[["set",["key"],"-1,-1,2"]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["seen","-1,-1,2"],true]],"note":"triple itself is the key, not the indices."},{"line":11,"ops":[["set",["out"],[[-1,-1,2]]]],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[["set",["j"],3]],"note":null},{"line":6,"ops":[["set",["k"],4]],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":8,"ops":[["set",["key"],"-1,0,1"]],"note":null},{"line":9,"ops":[],"note":null},{"line":10,"ops":[["set",["seen","-1,0,1"],true]],"note":"triple itself is the key, not the indices."},{"line":11,"ops":[["set",["out"],[[-1,-1,2],[-1,0,1]]]],"note":null},{"line":6,"ops":[["set",["k"],5]],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":6,"ops":[],"note":null},{"line":5,"ops":[["set",["j"],4]],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],2]],"note":null},{"line":5,"ops":[["set",["j"],3]],"note":null},{"line":6,"ops":[["set",["k"],4]],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":6,"ops":[["set",["k"],5]],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":6,"ops":[],"note":null},{"line":5,"ops":[["set",["j"],4]],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],3]],"note":null},{"