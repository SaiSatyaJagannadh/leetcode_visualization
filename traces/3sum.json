ine":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[["set",["j"],2]],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[],"note":null},{"line":6,"ops":[],"note":null},{"line":7,"ops":[],"note":"which is the whole cost: this is O(n^3) where the sweep is O(n^2)."},{"line":8,"ops":[],"note":null},{"line":9,"ops":[],"note":null},{"line":6,"ops":[],"note":null},{"line":5,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":12,"ops":[],"note":null}]}]},{"id":"sort-sweep","label":"Sort, then two pointers","complexity":{"time":"O(n\u00b2)","space":"O(n)"},"viz":{"ordered":"array","i":"pointer:ordered","lo":"pointer:ordered","hi":"pointer:ordered"},"layout":{},"source":["def sort_and_sweep(nums):","    ordered = sorted(nums)","    out = []","    for i in range(len(ordered) - 2):","        if i > 0 and ordered[i] == ordered[i - 1]:","            continue","        lo = i + 1","        hi = len(ordered) - 1","        while lo < hi:","            total = ordered[i] + ordered[lo] + ordered[hi]","            if total < 0:","                lo += 1","            elif total > 0:","                hi -= 1","            else:","                out.append([ordered[i], ordered[lo], ordered[hi]])","                while lo < hi and ordered[lo] == ordered[lo + 1]:","                    lo += 1","                while lo < hi and ordered[hi] == ordered[hi - 1]:","                    hi -= 1","                lo += 1","                hi -= 1","    return out"],"variants":[{"id":"typical","label":"Two triples","note":null,"result":[[-1,-1,2],[-1,0,1]],"steps":[{"line":0,"ops":[["set",["nums"],[-1,0,1,2,-1,-4]]],"note":null},{"line":1,"ops":[["set"