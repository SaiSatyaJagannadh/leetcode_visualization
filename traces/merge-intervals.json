{"schemaVersion":1,"slug":"merge-intervals","title":"Merge Intervals","pattern":"Intervals","difficulty":"Medium","leetcode":56,"prompt":"Given a list of intervals, combine every group that overlaps into a single interval and return the result. Intervals that merely touch at an endpoint count as overlapping.","examples":[{"input":"intervals = [[1,3],[2,6],[8,10],[15,18]]","output":"[[1,6],[8,10],[15,18]]","why":"[1,3] and [2,6] overlap, so they become [1,6]."},{"input":"intervals = [[1,4],[4,5]]","output":"[[1,5]]","why":"They touch at 4, which still counts."}],"constraints":["1 <= len(intervals) <= 10^4","start <= end for every interval"],"approaches":[{"id":"sweep","label":"Sort and sweep","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","out":"intervals","span":"interval"},"layout":{},"source":["def sweep(intervals):","    spans = sorted(intervals, key=lambda s: s[0])","    out = []","    for span in spans:","        if out and span[0] <= out[-1][1]:","            out[-1] = [out[-1][0], max(out[-1][1], span[1])]","        else:","            out.append([span[0], span[1]])","    return out"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[[1,6],[8,10],[15,18]],"steps":[{"line":0,"note":null,"ops":[["set",["intervals"],[[1,3],[2,6],[8,10],[15,18]]]]},{"line":1,"note":"interval we're building must start before it ends, so one pass is enough.","ops":[["set",["spans"],[[1,3],[2,6],[8,10],[15,18]]]]},{"line":2,"note":null,"ops":[["set",["out"],[]]]},{"line":3,"note":null,"ops":[["set",["span"],[1,3]]]},{"line":4,"note":null,"ops":[]},{"line":7,"note":"A clean gap. Nothing later can reach back past it, so close and move on.","ops":[["set",["out"],[[1,3]]]]},{"line":3,"note":null,"ops":[["set",["span",0],2],["set",["span",1],6]]},{"line":4,"note":null,"ops":[]},{"line":5,"note":"Overlaps the last kept interval, so widen that one instead of adding.","ops":[["set",["out",0,1],6]]},{"line":3,"note":null,"ops":[["set",["span",0],8],["set",["span",1],10]]},{"line":4,"note":null,"ops":[]},{"line":7,"note":"A clean gap. Nothing later can reach back past it, so close and move on.","ops":[["set",["out"],[[1,6],[8,10]]]]},{"line":3,"note":null,"ops":[["set",["span",0],15],["set",["span",1],18]]},{"line":4,"note":null,"ops":[]},{"line":7,"note":"A clean gap. Nothing later can reach back past it, so close and move on.","ops":[["set",["out"],[[1,6],[8,10],[15,18]]]]},{"line":3,"note":null,"ops":[]},{"line":8,"note":null,"ops":[]}]},{"id":"edge","label":"Nested","note":null,"result":[[1,10]],"steps":[{"line":0,"note":null,"ops":[["set",["intervals"],[[1,10],[3,5]]]]},{"line":1,"note":"interval we're building must start before it ends, so one pass is enough.","ops":[["set",["spans"],[[1,10],[3,5]]]]},{"line":2,"note":null,"ops":[["set",["out"],[]]]},{"line":3,"note":null,"ops":[["set",["span"],[1,10]]]},{"line":4,"note":null,"ops":[]},{"line":7,"note":"A clean gap. Nothing later can reach back past it, so close and move on.","ops":[["set",["out"],[[1,10]]]]},{"line":3,"note":null,"ops":[["set",["span",0],3],["set",["span",1],5]]},{"line":4,"note":null,"ops":[]},{"line":5,"note":"Overlaps the last kept interval, so widen that one instead of adding.","ops":[]},{"line":3,"note":null,"ops":[]},{"line":8,"note":null,"ops":[]}]},{"id":"worst-case","label":"Reverse order","note":null,"result":[[1,10],[15,18]],"steps":[{"line":0,"note":null,"ops":[["set",["intervals"],[[15,18],[8,10],[2,6],[1,3],[5,9]]]]},{"line":1,"note":"interval we're building must start before it ends, so one pass is enough.","ops":[["set",["spans"],[[1,3],[2,6],[5,9],[8,10],[15,18]]]]},{"line":2,"note":null,"ops":[["set",["out"],[]]]},{"line":3,"note":null,"ops":[["set",["span"],[1,3]]]},{"line":4,"note":null,"ops":[]},{"line":7,"note":"A clean gap. Nothing later can reach back past it, so close and move on.","ops":[["set",["out"],[[1,3]]]]},{"line":3,"note":null,"ops":[["set",["span",0],2],["set",["span",1],6]]