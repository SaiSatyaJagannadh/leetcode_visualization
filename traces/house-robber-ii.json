{"schemaVersion":1,"slug":"house-robber-ii","title":"House Robber II","pattern":"1-D Dynamic Programming","difficulty":"Medium","leetcode":213,"prompt":"Same as House Robber, except the houses form a circle, so the first and last are adjacent too.","examples":[{"input":"nums = [2,3,2]","output":"3","why":"Robbing 0 and 2 is now forbidden."},{"input":"nums = [1,2,3,1]","output":"4"}],"constraints":["1 <= len(nums) <= 100"],"approaches":[{"id":"two-passes","label":"Drop one end, twice","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"nums":"array"},"layout":{},"source":["def two_passes(nums):","    if len(nums) == 1:","        return nums[0]","    without_last = _line(nums[:-1])","    without_first = _line(nums[1:])","    return max(without_last, without_first)"],"variants":[{"id":"typical","label":"Circle bites","note":null,"result":3,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[2,3,2]]]},{"line":1,"note":null,"ops":[]},{"line":3,"note":"every legal choice, and neither run can wrap around.","ops":[["set",["without_last"],3]]},{"line":4,"note":null,"ops":[["set",["without_first"],3]]},{"line":5,"note":null,"ops":[]}]},{"id":"edge","label":"One house","note":null,"result":5,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[5]]]},{"line":1,"note":null,"ops":[]},{"line":2,"note":"With a single house there is no circle to worry about.","ops":[]}]},{"id":"worst-case","label":"Ends are richest","note":null,"result":7,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[6,1,1,6]]]},{"line":1,"note":null,"ops":[]},{"line":3,"note":"every legal choice, and neither run can wrap around.","ops":[["set",["without_last"],7]]},{"line":4,"note":null,"ops":[["set",["without_first"],7]]},{"line":5,"note":null,"ops":[]}]}]}]}