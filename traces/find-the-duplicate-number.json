{"schemaVersion":1,"slug":"find-the-duplicate-number","title":"Find the Duplicate Number","pattern":"Linked List","difficulty":"Medium","leetcode":287,"prompt":"An array of n+1 integers holds values from 1 to n, so at least one value repeats. Find it without modifying the array and using constant extra space.","examples":[{"input":"nums = [1,3,4,2,2]","output":"2"},{"input":"nums = [3,1,3,4,2]","output":"3"}],"constraints":["Values are between 1 and n","Read-only array, O(1) space"],"approaches":[{"id":"counting","label":"Count what you've seen","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"nums":"array"},"layout":{},"source":["def counting(nums):","    seen = {}","    for v in nums:","        if v in seen:","            return v","        seen[v] = True","    return -1"],"variants":[{"id":"typical","label":"Typical","note":null,"result":2,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[1,3,4,2,2]]]},{"line":1,"note":"Correct, but the counter is extra space the problem forbids.","ops":[["set",["seen"],{}]]},{"line":2,"note":null,"ops":[["set",["v"],1]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","1"],true]]},{"line":2,"note":null,"ops":[["set",["v"],3]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","3"],true]]},{"line":2,"note":null,"ops":[["set",["v"],4]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","4"],true]]},{"line":2,"note":null,"ops":[["set",["v"],2]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","2"],true]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]}]},{"id":"edge","label":"Repeat at the front","note":null,"result":3,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[3,1,3,4,2]]]},{"line":1,"note":"Correct, but the counter is extra space the problem forbids.","ops":[["set",["seen"],{}]]},{"line":2,"note":null,"ops":[["set",["v"],3]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","3"],true]]},{"line":2,"note":null,"ops":[["set",["v"],1]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","1"],true]]},{"line":2,"note":null,"ops":[["set",["v"],3]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]}]},{"id":"worst-case","label":"Repeated many times","note":null,"result":2,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[2,2,2,2,2]]]},{"line":1,"note":"Correct, but the counter is extra space the problem forbids.","ops":[["set",["seen"],{}]]},{"line":2,"note":null,"ops":[["set",["v"],2]]},{"line":3,"note":null,"ops":[]},{"line":5,"note":null,"ops":[["set",["seen","2"],true]]},{"line":2,"note":null,"ops":[]},{"line":3,"note":null,"ops":[]},{"line":4,"note":null,"ops":[]}]}]},{"id":"floyd","label":"Cycle detection","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","slow":"pointer:nums","fast":"pointer:nums"},"layout":{},"source":["def floyd(nums):","    slow = nums[0]","    fast = nums[nums[0]]","    while slow != fast:","        slow = nums[slow]","        fast = nums[nums[fast]]","    slow = 0","    while slow != fast:","        slow = nums[slow]","        fast = nums[fast]","    return slow"],"variants":[{"id":"typical","label":"Typical","note":null,"result":2,"steps":[{"line":0,"note":null,"ops":[["set",["nums"],[1,3,4,2,2]]]},{"line":1,"note":"contain a cycle, and its entrance is the duplicated value.","ops":[["set",["slow"],1]]},{"line":2,"note":null,"ops":[["set",["fast"],3]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":"One hop.","ops":[["set",["slow"],3]]},{"line":5,"note":"Two hops.","ops":[["set",["fast"],4]]},{"line":3,"note":null,"ops":[]},{"line":4,"note":"One hop.","ops":[["set",["slow"],2]]},{"line":5,"note":"Two hops.","ops":[]},{"line":3,"note":null,"ops":[]},{"line":4,"note":"One hop.","ops":[["set",["slow"],4]]},{"line":5,"note":"Two hops.","ops":[]},{"line":3,"note":null,"ops":[]},{"line":6,"note":"stepping both singly