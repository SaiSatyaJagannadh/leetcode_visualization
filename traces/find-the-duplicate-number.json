{"schemaVersion":1,"slug":"find-the-duplicate-number","title":"Find the Duplicate Number","pattern":"Linked List","difficulty":"Medium","leetcode":287,"prompt":"An array of n+1 integers holds values from 1 to n, so at least one value repeats. Find it without modifying the array and using constant extra space.","examples":[{"input":"nums = [1,3,4,2,2]","output":"2"},{"input":"nums = [3,1,3,4,2]","output":"3"}],"constraints":["Values are between 1 and n","Read-only array, O(1) space"],"approaches":[{"id":"counting","label":"Count what you've seen","complexity":{"time":"O(n)","space":"O(n)"},"viz":{"nums":"array"},"layout":{},"source":["def counting(nums):","    seen = {}","    for v in nums:","        if v in seen:","            return v","        seen[v] = True","    return -1"],"variants":[{"id":"typical","label":"Typical","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[1,3,4,2,2]]],"note":null},{"line":1,"ops":[["set",["seen"],{}]],"note":"Correct, but the counter is extra space the problem forbids."},{"line":2,"ops":[["set",["v"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","1"],true]],"note":null},{"line":2,"ops":[["set",["v"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","3"],true]],"note":null},{"line":2,"ops":[["set",["v"],4]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","4"],true]],"note":null},{"line":2,"ops":[["set",["v"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","2"],true]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null}]},{"id":"edge","label":"Repeat at the front","note":null,"result":3,"steps":[{"line":0,"ops":[["set",["nums"],[3,1,3,4,2]]],"note":null},{"line":1,"ops":[["set",["seen"],{}]],"note":"Correct, but the counter is extra space the problem forbids."},{"line":2,"ops":[["set",["v"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","3"],true]],"note":null},{"line":2,"ops":[["set",["v"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","1"],true]],"note":null},{"line":2,"ops":[["set",["v"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null}]},{"id":"worst-case","label":"Repeated many times","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[2,2,2,2,2]]],"note":null},{"line":1,"ops":[["set",["seen"],{}]],"note":"Correct, but the counter is extra space the problem forbids."},{"line":2,"ops":[["set",["v"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":5,"ops":[["set",["seen","2"],true]],"note":null},{"line":2,"ops":[],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":null}]}]},{"id":"floyd","label":"Cycle detection","complexity":{"time":"O(n)","space":"O(1)"},"viz":{"nums":"array","slow":"pointer:nums","fast":"pointer:nums"},"layout":{},"source":["def floyd(nums):","    slow = nums[0]","    fast = nums[nums[0]]","    while slow != fast:","        slow = nums[slow]","        fast = nums[nums[fast]]","    slow = 0","    while slow != fast:","        slow = nums[slow]","        fast = nums[fast]","    return slow"],"variants":[{"id":"typical","label":"Typical","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[1,3,4,2,2]]],"note":null},{"line":1,"ops":[["set",["slow"],1]],"note":"contain a cycle, and its entrance is the duplicated value."},{"line":2,"ops":[["set",["fast"],3]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["slow"],3]],"note":"One hop."},{"line":5,"ops":[["set",["fast"],4]],"note":"Two hops."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["slow"],2]],"note":"One hop."},{"line":5,"ops":[],"note":"Two hops."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["slow"],4]],"note":"One hop."},{"line":5,"ops":[],"note":"Two hops."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["slow"],0]],"note":"stepping both singly makes them meet exactly at the entrance."},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["slow"],1]],"note":null},{"line":9,"ops":[["set",["fast"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["slow"],3]],"note":null},{"line":9,"ops":[["set",["fast"],4]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["slow"],2]],"note":null},{"line":9,"ops":[["set",["fast"],2]],"note":null},{"line":7,"ops":[],"note":null},{"line":10,"ops":[],"note":null}]},{"id":"edge","label":"Repeat at the front","note":null,"result":3,"steps":[{"line":0,"ops":[["set",["nums"],[3,1,3,4,2]]],"note":null},{"line":1,"ops":[["set",["slow"],3]],"note":"contain a cycle, and its entrance is the duplicated value."},{"line":2,"ops":[["set",["fast"],4]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["slow"],4]],"note":"One hop."},{"line":5,"ops":[["set",["fast"],3]],"note":"Two hops."},{"line":3,"ops":[],"note":null},{"line":4,"ops":[["set",["slow"],2]],"note":"One hop."},{"line":5,"ops":[["set",["fast"],2]],"note":"Two hops."},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["slow"],0]],"note":"stepping both singly makes them meet exactly at the entrance."},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["slow"],3]],"note":null},{"line":9,"ops":[["set",["fast"],3]],"note":null},{"line":7,"ops":[],"note":null},{"line":10,"ops":[],"note":null}]},{"id":"worst-case","label":"Repeated many times","note":null,"result":2,"steps":[{"line":0,"ops":[["set",["nums"],[2,2,2,2,2]]],"note":null},{"line":1,"ops":[["set",["slow"],2]],"note":"contain a cycle, and its entrance is the duplicated value."},{"line":2,"ops":[["set",["fast"],2]],"note":null},{"line":3,"ops":[],"note":null},{"line":6,"ops":[["set",["slow"],0]],"note":"stepping both singly makes them meet exactly at the entrance."},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["slow"],2]],"note":null},{"line":9,"ops":[],"note"