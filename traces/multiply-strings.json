{"schemaVersion":1,"slug":"multiply-strings","title":"Multiply Strings","pattern":"Math & Geometry","difficulty":"Medium","leetcode":43,"prompt":"Multiply two non-negative integers given as strings, without converting them to numbers directly.","examples":[{"input":"num1 = \"12\", num2 = \"34\"","output":"\"408\""},{"input":"num1 = \"0\", num2 = \"999\"","output":"\"0\""}],"constraints":["1 <= len(num1), len(num2) <= 200","No leading zeros"],"approaches":[{"id":"long","label":"Long multiplication","complexity":{"time":"O(mn)","space":"O(m + n)"},"viz":{"digits":"array","i":"pointer:a","j":"pointer:b"},"layout":{},"source":["def long_multiplication(a, b):","    if a == \"0\" or b == \"0\":","        return \"0\"","    digits = [0] * (len(a) + len(b))","    for i in range(len(a) - 1, -1, -1):","        for j in range(len(b) - 1, -1, -1):","            product = int(a[i]) * int(b[j])","            pos = i + j + 1","            total = digits[pos] + product","            digits[pos] = total % 10","            digits[pos - 1] += total // 10","    start = 0","    while start < len(digits) - 1 and digits[start] == 0:","        start += 1","    return \"\".join(str(d) for d in digits[start:])"],"variants":[{"id":"typical","label":"Two digits each","note":null,"result":"408","steps":[{"line":0,"ops":[["set",["a"],"12"],["set",["b"],"34"]],"note":null},{"line":1,"ops":[],"note":null},{"line":3,"ops":[["set",["digits"],[0,0,0,0]]],"note":"carry going to i + j + 1. That fixed mapping is the whole algorithm."},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[["set",["product"],8]],"note":null},{"line":7,"ops":[["set",["pos"],3]],"note":null},{"line":8,"ops":[["set",["total"],8]],"note":null},{"line":9,"ops":[["set",["digits",3],8]],"note":null},{"line":10,"ops":[],"note":"slot is itself processed, so no separate carry pass is needed."},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[["set",["product"],6]],"note":null},{"line":7,"ops":[["set",["pos"],2]],"note":null},{"line":8,"ops":[["set",["total"],6]],"note":null},{"line":9,"ops":[["set",["digits",2],6]],"note":null},{"line":10,"ops":[],"note":"slot is itself processed, so no separate carry pass is needed."},{"line":5,"ops":[],"note":null},{"line":4,"ops":[["set",["i"],0]],"note":null},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[["set",["product"],4]],"note":null},{"line":7,"ops":[],"note":null},{"line":8,"ops":[["set",["total"],10]],"note":null},{"line":9,"ops":[["set",["digits",2],0]],"note":null},{"line":10,"ops":[["set",["digits",1],1]],"note":"slot is itself processed, so no separate carry pass is needed."},{"line":5,"ops":[["set",["j"],0]],"note":null},{"line":6,"ops":[["set",["product"],3]],"note":null},{"line":7,"ops":[["set",["pos"],1]],"note":null},{"line":8,"ops":[["set",["total"],4]],"note":null},{"line":9,"ops":[["set",["digits",1],4]],"note":null},{"line":10,"ops":[],"note":"slot is itself processed, so no separate carry pass is needed."},{"line":5,"ops":[],"note":null},{"line":4,"ops":[],"note":null},{"line":11,"ops":[["set",["start"],0]],"note":"Drop the leading zero the extra slot may have left behind."},{"line":12,"ops":[],"note":null},{"line":13,"ops":[["set",["start"],1]],"note":null},{"line":12,"ops":[],"note":null},{"line":14,"ops":[],"note":null}]},{"id":"edge","label":"Times zero","note":null,"result":"0","steps":[{"line":0,"ops":[["set",["a"],"0"],["set",["b"],"999"]],"note":null},{"line":1,"ops":[],"note":null},{"line":2,"ops":[],"note":null}]},{"id":"worst-case","label":"Heavy carrying","note":null,"result":"9801","steps":[{"line":0,"ops":[["set",["a"],"99"],["set",["b"],"99"]],"note":null},{"line":1,"ops":[],"note":null},{"line":3,"ops":[["set",["digits"],[0,0,0,0]]],"note":"carry going to i + j + 1. That fixed mapping is the whole algorithm."},{"line":4,"ops":[["set",["i"],1]],"note":null},{"line":5,"ops":[["set",["j"],1]],"note":null},{"line":6,"ops":[["set",["p