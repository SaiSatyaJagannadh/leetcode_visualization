{"schemaVersion":1,"slug":"min-stack","title":"Min Stack","pattern":"Stack","difficulty":"Medium","leetcode":155,"prompt":"Design a stack that also reports its smallest element, with push, pop, top and getMin all running in constant time. The trace replays a sequence of operations.","examples":[{"input":"push(-2), push(0), push(-3), getMin()","output":"-3"},{"input":"pop(), top(), getMin()","output":"0, then -2","why":"Removing -3 has to restore -2 as the minimum instantly."}],"constraints":["All four operations must be O(1)","pop and top are never called on an empty stack"],"approaches":[{"id":"paired","label":"Parallel minimum stack","complexity":{"time":"O(1) per op","space":"O(n)"},"viz":{"stack":"stack","mins":"stack","log":"queue","ops":"array"},"layout":{},"source":["def paired_stack(ops):","    stack = []","    mins = []","    log = []","    for op in ops:","        if op == \"pop\":","            stack.pop()","            mins.pop()","        else:","            stack.append(op)","            if mins:","                mins.append(min(op, mins[-1]))","            else:","                mins.append(op)","        log.append(mins[-1] if mins else None)","    return log"],"variants":[{"id":"typical","label":"Typical","note":null,"result":[-2,-2,-3,-2,-2,-2],"steps":[{"line":0,"note":null,"ops":[["set",["ops"],[-2,0,-3,"pop","pop",5]]]},{"line":1,"note":null,"ops":[["set",["stack"],[]]]},{"line":2,"note":"is what makes getMin O(1) \u2014 and makes pop restore the old minimum for free.","ops":[["set",["mins"],[]]]},{"line":3,"note":null,"ops":[["set",["log"],[]]]},{"line":4,"note":null,"ops":[["set",["op"],-2]]},{"line":5,"note":null,"ops":[]},{"line":9,"note":null,"ops":[["set",["stack"],[-2]]]},{"line":10,"note":"The new minimum is this value, or the old one, whichever is smaller.","ops":[]},{"line":13,"note":null,"ops":[["set",["mins"],[-2]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2]]]},{"line":4,"note":null,"ops":[["set",["op"],0]]},{"line":5,"note":null,"ops":[]},{"line":9,"note":null,"ops":[["set",["stack"],[-2,0]]]},{"line":10,"note":"The new minimum is this value, or the old one, whichever is smaller.","ops":[]},{"line":11,"note":null,"ops":[["set",["mins"],[-2,-2]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2,-2]]]},{"line":4,"note":null,"ops":[["set",["op"],-3]]},{"line":5,"note":null,"ops":[]},{"line":9,"note":null,"ops":[["set",["stack"],[-2,0,-3]]]},{"line":10,"note":"The new minimum is this value, or the old one, whichever is smaller.","ops":[]},{"line":11,"note":null,"ops":[["set",["mins"],[-2,-2,-3]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2,-2,-3]]]},{"line":4,"note":null,"ops":[["set",["op"],"pop"]]},{"line":5,"note":null,"ops":[]},{"line":6,"note":null,"ops":[["set",["stack"],[-2,0]]]},{"line":7,"note":"Discarding the paired entry rewinds the minimum automatically.","ops":[["set",["mins"],[-2,-2]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2,-2,-3,-2]]]},{"line":4,"note":null,"ops":[]},{"line":5,"note":null,"ops":[]},{"line":6,"note":null,"ops":[["set",["stack"],[-2]]]},{"line":7,"note":"Discarding the paired entry rewinds the minimum automatically.","ops":[["set",["mins"],[-2]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2,-2,-3,-2,-2]]]},{"line":4,"note":null,"ops":[["set",["op"],5]]},{"line":5,"note":null,"ops":[]},{"line":9,"note":null,"ops":[["set",["stack"],[-2,5]]]},{"line":10,"note":"The new minimum is this value, or the old one, whichever is smaller.","ops":[]},{"line":11,"note":null,"ops":[["set",["mins"],[-2,-2]]]},{"line":14,"note":null,"ops":[["set",["log"],[-2,-2,-3,-2,-2,-2]]]},{"line":4,"note":null,"ops":[]},{"line":15,"note":null,"ops":[]}]},{"id":"edge","label":"Ascending pushes","note":null,"result":[1,1,1,1],"steps":[{"line":0,"note":null,"ops":[["set",["ops"],[1,2,3,"pop"]]]},{"line":1,"note":null,"ops":[["set",["stack"],[]]]},{"line":2,"note":"is what makes getMin O(1) \u2014 and makes pop restore the old minimum for free.","ops":[["set",["mins"],[