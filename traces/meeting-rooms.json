{"schemaVersion":1,"slug":"meeting-rooms","title":"Meeting Rooms","pattern":"Intervals","difficulty":"Easy","leetcode":252,"prompt":"Given a list of meeting times, decide whether one person could attend all of them without a clash.","examples":[{"input":"intervals = [[0,30],[5,10],[15,20]]","output":"false"},{"input":"intervals = [[7,10],[2,4]]","output":"true"}],"constraints":["0 <= len(intervals) <= 10^4"],"approaches":[{"id":"sort","label":"Sort, then check neighbours","complexity":{"time":"O(n log n)","space":"O(n)"},"viz":{"intervals":"intervals","spans":"intervals","i":"pointer:spans"},"layout":{},"source":["def sort_and_compare(intervals):","    spans = sorted(intervals, key=lambda s: s[0])","    for i in range(1, len(spans)):","        if spans[i][0] < spans[i - 1][1]:","            return False","    return True"],"variants":[{"id":"typical","label":"Clashes","note":null,"result":false,"steps":[{"line":0,"ops":[["set",["intervals"],[[0,30],[5,10],[15,20]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[0,30],[5,10],[15,20]]]],"note":"overlapped one further back, it would overlap its neighbour too."},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":4,"ops":[],"note":"fine, hence strict less-than."}]},{"id":"edge","label":"No clash","note":null,"result":true,"steps":[{"line":0,"ops":[["set",["intervals"],[[7,10],[2,4]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[2,4],[7,10]]]],"note":"overlapped one further back, it would overlap its neighbour too."},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]},{"id":"worst-case","label":"Touching is fine","note":null,"result":true,"steps":[{"line":0,"ops":[["set",["intervals"],[[1,5],[5,8]]]],"note":null},{"line":1,"ops":[["set",["spans"],[[1,5],[5,8]]]],"note":"overlapped one further back, it would overlap its neighbour too."},{"line":2,"ops":[["set",["i"],1]],"note":null},{"line":3,"ops":[],"note":null},{"line":2,"ops":[],"note":null},{"line":5,"ops":[],"note":null}]}]}]}