   "layout": {},
   "source": [
    "def max_subarray_sum_brute_force(nums):",
    "    max_so_far = nums[0]",
    "    for i in range(len(nums)):",
    "        current_sum = 0",
    "        for j in range(i, len(nums)):",
    "            current_sum += nums[j]",
    "            max_so_far = max(max_so_far, current_sum)",
    "    return max_so_far"
   ],
