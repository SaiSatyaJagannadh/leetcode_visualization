 "pattern": "Dynamic Programming",
 "difficulty": "Medium",
 "prompt": "Given an array of integers, return the maximum sum of any contiguous subarray.",
 "examples": [
  {
   "input": "nums = [-2,1,-3,4,-1,2,1,-5,4]",
   "output": "6",
   "why": "The contiguous subarray [4,-1,2,1] has the largest sum = 6."
  },
  {
   "input": "nums = [1]",
   "output": "1",
   "why": "The subarray [1] has the largest sum = 1."
  },
  {
   "input": "nums = [5,4,-1,7,8]",
   "output": "23",
   "why": "The subarray [5,4,-1,7,8] has the largest sum = 23."
  }
 ],
