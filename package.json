{
  "name": "leetviz",
  "private": true,
  "scripts": {
    "dev": "python3 pipeline/devserver.py & trap 'kill %1 2>/dev/null' EXIT INT TERM; next dev",
    "dev:api": "python3 pipeline/devserver.py",
    "build": "pnpm run schema -- --check && python3 tracer/build.py && NEXT_DIST=${NEXT_DIST:-.next-build} next build",
    "start": "next start",
    "trace": "python3 tracer/build.py",
    "check": "python3 pipeline/check.py && pnpm run schema -- --check",
    "test": "python3 pipeline/test_solve.py && python3 pipeline/check_streamlit.py",
    "schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON pipeline/schema-json.mts"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
}
