# Copy to .env and fill in. Real values live in .env (gitignored) and in the
# Vercel project settings. NOTHING here may ever be prefixed NEXT_PUBLIC_ except
# the two entries explicitly marked public — that prefix inlines the value into
# the client bundle, and CI greps the bundle for `sk-…` to enforce it.

# --- generation (server only; the generator is still a stub this pass) --------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Vercel KV / Upstash Redis (server only) ---------------------------------
# Required in production: /api refuses to start without them there. Locally,
# leaving them blank falls back to a file store and logs a loud warning.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_LOCAL_PATH=/tmp/leetviz-kv.json

# --- Cloudflare Turnstile ----------------------------------------------------
TURNSTILE_SECRET=
# PUBLIC by design — a Turnstile site key is meant to ship to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- cost guards -------------------------------------------------------------
# Free generations per day, counted against the session cookie AND the IP;
# exhausting either one returns 402.
SOLVE_FREE_PER_DAY=5
# When the month's recorded spend reaches this, the free tier switches off and
# /api/solve serves bring-your-own-key only (503 without one).
SOLVE_MONTHLY_USD_CAP=25
# Placeholder unit cost while generation is stubbed; the real per-call cost
# replaces it when the OpenAI call lands.
SOLVE_STUB_COST_USD=0.02

# --- /admin/spend ------------------------------------------------------------
# Sent as the x-admin-secret header. Unset means the endpoint is closed, not open.
ADMIN_SECRET=

# --- set by Vercel, listed for reference --------------------------------------
# VERCEL_ENV=production

# /api/solve status codes:
#   400 no prompt (rejected before any gate; nothing spent)
#   403 turnstile verification failed
#   200 cache hit (cached:true) or fresh generation
#   402 daily quota exhausted — body describes the bring-your-own-key path
#   503 monthly spend cap reached — free tier off, BYO key still works
#   502 generation failed
#   401 /api/admin/spend without a valid x-admin-secret
