# Copy to .env and fill in. Real values live in .env (gitignored) and in the
# Vercel project settings. NOTHING here may ever be prefixed NEXT_PUBLIC_ except
# the two entries explicitly marked public — that prefix inlines the value into
# the client bundle, and CI greps the bundle for `sk-…` to enforce it.

# --- generation (server only) -------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# The model ladder. These are the ONLY place a model name is allowed to appear —
# nothing in api/ or pipeline/ contains a model literal, and `pnpm test` checks
# that the names still come from here. Leaving OPENAI_MODEL_GENERATE unset makes
# /api/solve serve the committed two-sum trace with a loud warning (dev only; it
# refuses outright when VERCEL_ENV=production).
#   CHEAP    normalize + classify, runs on the hash gate of EVERY request
#   GENERATE the trace itself, structured outputs, strict mode
#   REPAIR   escalation after a semantic failure, at most 2 attempts
OPENAI_MODEL_CHEAP=gpt-5.4-nano
OPENAI_MODEL_GENERATE=gpt-5.4
OPENAI_MODEL_REPAIR=gpt-5.5
# Override to point at a compatible gateway. Default https://api.openai.com/v1
OPENAI_BASE_URL=

# --- NVIDIA NIM: the fallback when OpenAI rate-limits or faults -------------
# NIM speaks the OpenAI chat-completions protocol, so only the base URL, the key
# and the model names differ. Used ONLY as a fallback: a healthy OpenAI key never
# silently downgrades. Failover triggers on 429 and 5xx, never on a 400 (our bug)
# and never on a trace that will not replay (a weaker model is not the fix).
#
# NOTE: `strict: true` is an OpenAI feature. On NIM the schema is a request, not
# a contract, so malformed JSON is possible and is routed into the repair ladder
# rather than assumed away. Expect a slightly higher repair rate here.
#
# Keys look like nvapi-… — the log redactor and the CI bundle scan both match
# that prefix as well as sk-.
NVIDIA_API_KEY=
# Verified against a live NIM key on 2026-07-29. The free tier is congested, so
# availability matters as much as capability — measured round-trips on a trivial
# schema request:
#   openai/gpt-oss-20b                    5.2s   works, OpenAI-lineage  <- chosen
#   meta/llama-3.1-70b-instruct           9.6s   valid JSON, but ignores the
#                                                "last step must be a return"
#                                                rule and burns the repair budget
#   meta/llama-3.3-70b-instruct         154.9s   too slow for a serverless budget
#   openai/gpt-oss-120b                timeout
#   deepseek-ai/deepseek-v4-flash/-pro  529 overloaded / timeout
#   nvidia/llama-3.1-nemotron-70b       404 for this account
#   nemotron-super-49b-v1.5             returns no `content` (reasoning-only shape)
NVIDIA_MODEL_CHEAP=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_GENERATE=openai/gpt-oss-20b
NVIDIA_MODEL_REPAIR=openai/gpt-oss-20b
# Override only to point at a self-hosted NIM. Default: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=


# Hard cap per call. Reasoning tokens bill against this and are not visible in
# the response, so /admin/spend reports billed and visible output separately.
SOLVE_MAX_OUTPUT_TOKENS=16000

# Per-million-token prices for the GENERATE model, used to turn real token
# counts into real dollars. Leave them blank and every call is billed at
# SOLVE_STUB_COST_USD instead — an unpriced call must not count as free, or the
# monthly cap stops capping.
SOLVE_PRICE_IN_PER_MTOK=
SOLVE_PRICE_CACHED_IN_PER_MTOK=
SOLVE_PRICE_OUT_PER_MTOK=

# --- Vercel KV / Upstash Redis (server only) ---------------------------------
# Required in production: /api refuses to start without them there. Locally,
# leaving them blank falls back to a file store and logs a loud warning.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_LOCAL_PATH=/tmp/leetviz-kv.json

# --- Cloudflare Turnstile ----------------------------------------------------
TURNSTILE_SECRET=
# PUBLIC by design — a Turnstile site key is meant to ship to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- cost guards -------------------------------------------------------------
# Free generations per day, counted against the session cookie AND the IP;
# exhausting either one returns 402.
SOLVE_FREE_PER_DAY=5
# When the month's recorded spend reaches this, the free tier switches off and
# /api/solve serves bring-your-own-key only (503 without one).
SOLVE_MONTHLY_USD_CAP=25
# Fallback unit cost: used when the SOLVE_PRICE_* entries above are blank, and
# by the offline dev generator.
SOLVE_STUB_COST_USD=0.02

# --- /admin/spend ------------------------------------------------------------
# Sent as the x-admin-secret header. Unset means the endpoint is closed, not open.
ADMIN_SECRET=

# --- set by Vercel, listed for reference --------------------------------------
# VERCEL_ENV=production

# /api/solve status codes:
#   400 no prompt (rejected before any gate; nothing spent)
#   403 turnstile verification failed
#   200 cache hit (cached:true) or fresh generation
#   402 daily quota exhausted — body describes the bring-your-own-key path
#   503 monthly spend cap reached — free tier off, BYO key still works
#   502 generation failed
#   401 /api/admin/spend without a valid x-admin-secret
